// Renderium - Ray Tracing Shaders
// shadow.rchitglsl - 阴影光线最近命中着色器
// 功能: 处理阴影光线的最近命中事件 (通常不应被调用)
//
// 扩展要求: GLSL #version 460 + GL_EXT_ray_tracing
// 管线类型: Closest Hit Shader (closesthit)
// 触发条件: 光线与几何体发生最近交点时调用
//
// 注意: 对于阴影光线，通常使用 gl_RayFlagsSkipClosestHitShaderEXT 标志，
//       因此此 Shader 主要用于调试或特殊情况

#version 460 core
#extension GL_EXT_ray_tracing : require;

// ==================== Hit Attributes ====================

/**
 * 重心坐标属性 (Barycentric Coordinates)
 * <p>
 * 描述命中点在三角形内的位置 (u, v, w)。
 * 用于插值顶点属性 (位置、法线、UV 等)。
 *
 * <h3>含义：</h3>
 * <pre>
 * 命中点 = u * vertex0 + v * vertex1 + w * vertex2
 * 其中: u + v + w = 1.0
 * </pre>
 */
hitAttributeEXT vec2 barycentrics;

/**
 * 可选: 命中距离 (T值)
 * <p>
 * 从光线起点到命中点的距离。
 * gl_HitTEXT 是内置变量，这里显式声明以供自定义逻辑使用。
 */
hitAttributeEXT vec3 hitT;

// ==================== Payload 定义 ====================

/**
 * 阴影光线 Payload (与 raygen.raygen 中定义的一致)
 */
layout(location = 0) rayPayloadInEXT ShadowPayload {
    float hitT;       // 命中距离
    bool visible;     // 是否可见
} payload;

// ==================== 描述符绑定 ====================

/**
 * 顶点位置缓冲区 (只读)
 * <p>
 * 存储所有顶点的世界空间位置。
 * 用于计算精确的命中点和表面属性。
 */
layout(set = 0, binding = 10) readonly buffer VertexPositions {
    vec4 positions[];     // xyz = 位置, w = padding
};

/**
 * 顶点法线缓冲区 (只读)
 */
layout(set = 0, binding = 11) readonly buffer VertexNormals {
    vec4 normals[];       // xyz = 法线, w = padding
};

/**
 * 顶点 UV 缓冲区 (可选，用于纹理采样)
 */
layout(set = 0, binding = 12) readonly buffer VertexUVs {
    vec4 uvs[];           // xy = UV 坐标, zw = padding
};

/**
 * 索引缓冲区 (三角形列表)
 */
layout(set = 0, binding = 13) readonly buffer Indices {
    uint indices[];       // 三角形索引数组 [v0, v1, v2, v0, v1, v2, ...]
};

// ==================== 辅助函数 ====================

/**
 * 使用重心坐标插值三角形属性
 *
 * @param attr0 顶点 0 的属性值
 * @param attr1 顶点 1 的属性值
 * @param attr2 顶点 2 的属性值
 * @param bary   重心坐标 (u, v), w = 1.0 - u - v
 * @return 插值后的属性值
 */
vec3 interpolateAttrib(vec3 attr0, vec3 attr1, vec3 attr2, vec2 bary) {
    float w = 1.0 - bary.x - bary.y;
    return attr0 * w + attr1 * bary.x + attr2 * bary.y;
}

vec2 interpolateAttrib(vec2 attr0, vec2 attr1, vec2 attr2, vec2 bary) {
    float w = 1.0 - bary.x - bary.y;
    return attr0 * w + attr1 * bary.x + attr2 * bary.y;
}

// ==================== 主函数 ====================

/**
 * Closest Hit 主入口
 *
 * <h3>触发时机：</h3>
 * 当光线与场景中的某个图元（通常是三角形）产生最近交点时被调用。
 * 对于阴影光线，这表示光线在到达光源之前被某物遮挡。
 *
 * <h3>内置可用变量：</h3>
 * <ul>
 *   <li>gl_PrimitiveID: 命中的图元 ID (在此 Buffer 中的索引)</li>
 *   <li>gl_InstanceID: 命中的实例 ID (TLAS 实例索引)</li>
 *   <li>gl_InstanceCustomIndexEXT: 实例的自定义索引 (来自 InstanceData.customIndex)</li>
 *   <li>gl_GeometryIndexEXT: 几何体索引 (BLAS 内部的几何体索引)</li>
 *   <li>gl_HitTEXT: 命中距离 T 值</li>
 *   <li>gl_HitKindEXT: 命中类型 (三角形/过程化几何)</li>
 *   <li>gl_WorldRayOriginEXT: 光线起点 (世界空间)</li>
 *   <li>gl_WorldRayDirectionEXT: 光线方向 (世界空间)</li>
 *   <li>gl_ObjectRayOriginEXT: 光线起点 (对象空间)</li>
 *   <li>gl_ObjectRayDirectionEXT: 光线方向 (对象空间)</li>
 * </ul>
 *
 * <h3>对于阴影光线的处理：</h3>
 * 通常情况下，阴影光线应设置 gl_RayFlagsSkipClosestHitShaderEXT，
 * 此时此 Shader 不会被调用。如果被调用，说明:
 * <ol>
 *   <li>未设置 SkipClosestHitShader 标志 (调试模式)</li>
 *   <li>需要执行额外处理 (如透明物体的 alpha 测试)</li>
 * </ol>
 */
void main() {
    // ========== 获取命中信息 ==========

    // 图元 ID 和实例 ID
    uint primitiveId = gl_PrimitiveID;
    uint instanceId = gl_InstanceID;
    uint customIndex = gl_InstanceCustomIndexEXT;

    // 计算索引偏移量 (每个三角形 3 个索引)
    uint indexOffset = primitiveId * 3u;

    // 读取三角形顶点索引
    uint idx0 = indices[indexOffset + 0u];
    uint idx1 = indices[indexOffset + 1u];
    uint idx2 = indices[indexOffset + 2u];

    // ========== 插值顶点属性 ==========

    // 获取重心坐标
    vec2 bary = barycentrics;
    float w = 1.0 - bary.x - bary.y;

    // 插值世界空间位置
    vec3 pos0 = positions[idx0].xyz;
    vec3 pos1 = positions[idx1].xyz;
    vec3 pos2 = positions[idx2].xyz;
    vec3 hitPosition = interpolateAttrib(pos0, pos1, pos2, bary);

    // 插值法线 (需要变换到世界空间)
    vec3 nrm0 = normals[idx0].xyz;
    vec3 nrm1 = normals[idx1].xyz;
    vec3 nrm2 = normals[idx2].xyz;
    vec3 objectNormal = interpolateAttrib(nrm0, nrm1, nrm2, bary);
    objectNormal = normalize(objectNormal); // 确保归一化

    // ========== 更新 Payload ==========

    // 记录命中信息
    payload.hitT = gl_HitTEXT;  // 命中距离

    // 对于阴影光线: 命中意味着被遮挡 → 不可见
    payload.visible = false;

    // ========== 可选的高级功能 ==========

    // [可选] Alpha 测试 (半透明物体)
    // 如果材质有 alpha 通道且 alpha < threshold，则忽略此次命中
    // (让光线继续穿透)
    //
    // vec2 uv0 = uvs[idx0].xy;
    // vec2 uv1 = uvs[idx1].xy;
    // vec2 uv2 = uvs[idx2].xy;
    // vec2 hitUV = interpolateAttrib(uv0, uv1, uv2, bary);
    // float alpha = texture(alphaTexture, hitUV).r;
    // if (alpha < 0.5) {
    //     ignoreIntersectionEXT; // 忽略此次命中，继续追踪
    // }

    // [可选] 法线偏移验证 (避免错误的遮挡)
    // 如果命中面的法线与光线方向几乎平行 (背向),
    // 可能是数值误差导致的假命中
    //
    // float NdotL = dot(objectNormal, gl_WorldRayDirectionEXT);
    // if (NdotL > 0.0) {
    //     // 背面命中 → 可能是假阳性 (从内部击中背面)
    //     // 可以选择忽略或降低权重
    // }

    // ========== 调试输出 (开发阶段) ==========

    #ifdef DEBUG_SHADOW_RAYS
        // 将命中信息写入调试缓冲区 (仅调试模式启用)
        // debugBuffer[gl_LaunchIDEXT.xy] = uvec4(
        //     instanceId,
        //     primitiveId,
        //     floatBitsToUint(gl_HitTEXT),
        //     packHalf2x16(hitPosition.xy)
        // );
    #endif
}
