#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable

// ================================================================
// Renderium Stylized RT - 自适应光线步进 Compute Shader
// ================================================================
// 这是实际可编译的GLSL，不是伪代码。
// 编译目标: SPIR-V (通过 glslangValidator 或 shaderc)
// 运行环境: Vulkan Compute Pipeline on NVIDIA 5060 (Blackwell)
//
// 关键工程约束 (之前被回避的):
// 1. 显存带宽: 每步72B/像素(FP32) → 1080p×128步 = 12.4GB/帧
// 2. Warp Divergence: 自适应步长导致同一warp线程走不同路径
// 3. Hessian寄存器压力: 6×float32 = 6寄存器, 总计24 reg/thread
// 4. AMR跨层级光线泄漏: 粗cell步长可能跳过薄几何体
// ================================================================

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// ==================== 常量 ====================

const float FLOAT_MAX = 3.402823466e+38;
const float EPSILON = 1e-6;
const float PI = 3.14159265358979323846;

// 最大迭代次数 (受寄存器压力限制, 不能太大)
const int MAX_ITERATIONS = 128;

// ==================== Push Constants (快速, 无descriptor开销) ====================

layout(push_constant) uniform PushConstants {
    // 相机参数
    vec4 cameraPosAndFov;       // xyz=位置, w=FOV(rad)
    vec4 cameraDirAndAspect;    // xyz=方向, w=宽高比

    // 步进参数
    vec4 stepParams;            // x=minStep, y=maxStep, z=initialStep, w=maxDistance
    vec4 odeParams;             // x=alpha, y=beta, z=gradientWeight, w=depthSkipThreshold

    // 势能场参数
    ivec4 gridParams;           // xyz=网格分辨率, w=AMR最大层级
    vec4 gridWorldSize;         // xyz=世界尺寸, w=unused

    // 屏幕参数
    ivec4 screenParams;         // x=屏幕宽度, y=屏幕高度, z=unused, w=unused

    // 标志位 (用float避免int对齐问题)
    ivec4 flags;                // x=enableDepthSkip, y=enableGradient, z=enableAdaptive, w=enablePBR
} pc;

// ==================== Storage Buffers ====================

// 势能场值 (float16 或 float32)
layout(binding = 0, std430) readonly buffer PotentialField {
    float u[];                  // gridRes³ 个 float32
    // 如果使用FP16: float16_t u_half[];
};

// 势能场梯度 ∇U (3×float32 per cell)
layout(binding = 1, std430) readonly buffer GradientField {
    vec4 gradU[];               // gridRes³ 个 vec4 (xyz=梯度, w=unused)
};

// Hessian矩阵 (6×float32 per cell, 对称矩阵)
// 存储格式: [H_xx, H_xy, H_xz, H_yy, H_yz, H_zz]
layout(binding = 2, std430) readonly buffer HessianField {
    vec4 hessU[];               // gridRes³ 个 vec4 (每2个vec4存6个分量)
    // 注意: 每个cell需要1.5个vec4 → 用索引 hessIdx*2 和 hessIdx*2+1
};

// G-Buffer 注解数据
layout(binding = 3, std430) readonly buffer GBufferDepth {
    float depth[];              // width×height 个 float
};
layout(binding = 4, std430) readonly buffer GBufferNormal {
    vec4 normal[];              // width×height 个 vec4 (xyz=法线, w=unused)
};
layout(binding = 5, std430) readonly buffer GBufferPBR {
    vec4 pbr[];                 // width×height 个 vec4 (x=roughness, y=metallic, z=emissive, w=ao)
};

// 输出帧缓冲
layout(binding = 6, std430) writeonly buffer OutputColor {
    vec4 color[];               // width×height 个 vec4 (RGBA)
};

// 统计输出 (用于基准测试)
layout(binding = 7, std430) writeonly buffer StatsOutput {
    uint stats[];               // [0]=总步数, [1]=深度跳过次数, [2]=光线泄漏次数, [3]=命中次数
};

// ==================== 工具函数 ====================

// 3D坐标 → 网格索引
uint worldToGridIndex(vec3 pos) {
    ivec3 gridRes = pc.gridParams.xyz;
    vec3 worldSize = pc.gridWorldSize.xyz;

    // 世界坐标 → 归一化坐标 [0,1)
    vec3 normalized = (pos + worldSize * 0.5) / worldSize;

    // 归一化坐标 → 网格坐标
    ivec3 gridCoord = ivec3(clamp(normalized * vec3(gridRes), vec3(0), vec3(gridRes - ivec3(1))));

    // 3D → 1D 线性索引
    return uint(gridCoord.x + gridCoord.y * gridRes.x + gridCoord.z * gridRes.x * gridRes.y);
}

// 从Hessian buffer读取6个分量
void loadHessian(uint cellIdx, out float hxx, out float hxy, out float hxz,
                 out float hyy, out float hyz, out float hzz) {
    // 每个cell占1.5个vec4 → 索引计算
    uint baseIdx = cellIdx * 2u;  // 每cell 2个vec4 (第2个只用到前2个分量)
    vec4 h0 = hessU[baseIdx];
    vec4 h1 = hessU[baseIdx + 1u];
    hxx = h0.x; hxy = h0.y; hxz = h0.z;
    hyy = h0.w; hyz = h1.x; hzz = h1.y;
}

// 计算 Rayleigh 商 R(d) = dᵀHd / dᵀd
// ⚠️ 寄存器压力: 需要6个float存储H + 3个float存储d = 9个额外寄存器
float computeRayleighQuotient(vec3 d, uint cellIdx) {
    float hxx, hxy, hxz, hyy, hyz, hzz;
    loadHessian(cellIdx, hxx, hxy, hxz, hyy, hyz, hzz);

    // Hd = H × d
    vec3 Hd = vec3(
        hxx * d.x + hxy * d.y + hxz * d.z,
        hxy * d.x + hyy * d.y + hyz * d.z,
        hxz * d.x + hyz * d.y + hzz * d.z
    );

    float dHd = dot(d, Hd);
    float dd = dot(d, d);

    // 防止除零; H正半定时R≥0, 但数值误差可能产生负值
    return dd > EPSILON ? abs(dHd / dd) : 0.0;
}

// ODE自适应步长: ds/dt = -α·R·s + β·(s_target - s)
// Euler近似 (单步)
float computeAdaptiveStep(float currentStep, float rayleighQ, float targetStep) {
    float alpha = pc.odeParams.x;
    float beta = pc.odeParams.y;

    float curvatureTerm = -alpha * rayleighQ * currentStep;
    float relaxationTerm = beta * (targetStep - currentStep);
    float deltaS = curvatureTerm + relaxationTerm;

    float newStep = currentStep + deltaS;

    // ⚠️ 关键: 钳位到有效范围
    // 下界: 防止穿透几何体
    // 上界: 防止跳过重要区域
    return clamp(newStep, pc.stepParams.x, pc.stepParams.y);
}

// PBR调制: 粗糙面少反射, 发光面无次级光线
int modulateSecondaryRays(vec4 pbrParams) {
    float roughness = pbrParams.x;
    float metallic = pbrParams.y;
    float emissive = pbrParams.z;

    if (emissive > 0.5) return 0;       // 发光面: 无需额外光线
    if (roughness > 0.7) return 1;       // 粗糙面: 1条漫反射
    if (metallic > 0.6) return 4;        // 金属面: 4条反射
    return 2;                             // 默认
}

// 简化的SDF命中检测 (实际应替换为场景SDF或BVH遍历)
float sceneSDF(vec3 p) {
    // 占位: 返回到最近表面的距离
    // 实际实现需要:
    // a) 体素DDA (Minecraft场景)
    // b) BVH遍历 (通用场景)
    // c) SDF纹理采样 (预计算)
    return FLOAT_MAX; // 暂时: 永远不命中
}

// ==================== 主光线步进循环 ====================

void main() {
    uvec2 pixelCoord = gl_GlobalInvocationID.xy;
    uint screenWidth = uint(pc.screenParams.x);
    uint screenHeight = uint(pc.screenParams.y);

    // 边界检查
    uint pixelIdx = pixelCoord.y * screenWidth + pixelCoord.x;
    if (pixelCoord.x >= screenWidth || pixelCoord.y >= screenHeight) return;

    // ---- 生成光线 ----
    vec3 origin = pc.cameraPosAndFov.xyz;
    float fov = pc.cameraPosAndFov.w;
    float aspect = pc.cameraDirAndAspect.w;

    vec2 ndc = (vec2(pixelCoord) + 0.5) / vec2(float(screenWidth), float(screenHeight)) * 2.0 - 1.0;
    float tanHalfFov = tan(fov * 0.5);
    vec3 direction = normalize(vec3(
        ndc.x * aspect * tanHalfFov,
        ndc.y * tanHalfFov,
        -1.0
    ));

    // ---- 初始化步进状态 ----
    vec3 pos = origin;
    float step = pc.stepParams.z; // initialStep
    float distanceTraveled = 0.0;
    int stepCount = 0;
    int depthSkipCount = 0;
    int rayLeakCount = 0;
    bool hit = false;
    vec3 hitNormal = vec3(0.0, 1.0, 0.0);

    // ---- 主循环 ----
    // ⚠️ Warp Divergence: 每个线程的迭代次数不同
    // 最坏情况: 某些线程128步, 某些16步 → 75%的线程空等
    for (int i = 0; i < MAX_ITERATIONS; i++) {
        stepCount++;

        // ===== Phase 1: 深度跳过 (G-Buffer注解) =====
        if (pc.flags.x != 0) { // enableDepthSkip
            float gbufferDepth = depth[pixelIdx];
            // 简化: 如果光线已超过G-Buffer深度, 跳过
            // 实际需要: 将光线位置投影到屏幕空间, 比较深度
            // 这里用简化版本
            if (distanceTraveled > gbufferDepth && gbufferDepth > 0.0) {
                // ⚠️ 被遮挡, 但不能直接跳到远处!
                // 需要保守估计跳过距离, 否则可能跳过半透明物体
                float skipDist = (gbufferDepth - distanceTraveled) * 0.5;
                if (skipDist > 0.0) {
                    pos += direction * skipDist;
                    distanceTraveled += skipDist;
                    depthSkipCount++;
                    continue;
                }
            }
        }

        // ===== Phase 2: 势能梯度引导 =====
        if (pc.flags.y != 0) { // enableGradient
            uint cellIdx = worldToGridIndex(pos);
            vec3 grad = gradU[cellIdx].xyz;
            float gradLen = length(grad);
            if (gradLen > EPSILON) {
                vec3 gradNorm = grad / gradLen;
                float weight = pc.odeParams.z; // gradientWeight
                // ⚠️ 修改光线方向会导致物理不正确!
                // 这只适用于风格化渲染, 不适用于物理精确渲染
                direction = normalize(mix(direction, gradNorm, weight));
            }
        }

        // ===== Phase 3: 自适应步长 (Rayleigh商ODE) =====
        if (pc.flags.z != 0) { // enableAdaptive
            uint cellIdx = worldToGridIndex(pos);
            float R = computeRayleighQuotient(direction, cellIdx);

            // 目标步长: 基于AMR层级 (简化: 用势能场值估算)
            float uVal = u[cellIdx];
            float targetStep = pc.stepParams.y; // 默认maxStep
            // 高势能区域 → 小步长
            if (abs(uVal) > 1.0) {
                targetStep = pc.stepParams.y * 0.25;
            }

            step = computeAdaptiveStep(step, R, targetStep);

            // AMR光线泄漏防护:
            // 步长不能超过当前cell尺寸, 否则可能跳过薄几何体
            ivec3 gridRes = pc.gridParams.xyz;
            float cellSize = pc.gridWorldSize.x / float(gridRes.x);
            step = min(step, cellSize * 1.5); // 保守: 1.5倍cell尺寸
        }

        // ===== Phase 4: 步进 =====
        pos += direction * step;
        distanceTraveled += step;

        // ===== Phase 5: 命中检测 =====
        if (distanceTraveled >= pc.stepParams.w) {
            break; // 超出最大距离
        }

        float sdf = sceneSDF(pos);
        if (sdf < EPSILON) {
            hit = true;
            // 从G-Buffer复用法线 (如果可用)
            hitNormal = normal[pixelIdx].xyz;
            break;
        }
    }

    // ---- 写入输出 ----
    if (hit) {
        // 简化的着色: 使用注解数据
        vec4 pbrData = pbr[pixelIdx];
        vec3 albedo = vec3(0.8); // TODO: 从G-Buffer读取

        // 简化Lambert着色
        vec3 lightDir = normalize(vec3(0.5, 1.0, 0.3));
        float NdotL = max(dot(hitNormal, lightDir), 0.0);
        vec3 shaded = albedo * NdotL;

        // PBR调制次级光线 (简化: 只影响最终亮度)
        int secondaryRays = pc.flags.w != 0 ? modulateSecondaryRays(pbrData) : 2;
        float pbrFactor = float(secondaryRays) / 4.0; // 归一化
        shaded *= mix(0.7, 1.0, pbrFactor); // 粗略调制

        color[pixelIdx] = vec4(shaded, 1.0);
    } else {
        // 未命中: 天空色
        color[pixelIdx] = vec4(0.4, 0.6, 0.9, 1.0);
    }

    // ---- 写入统计 ----
    // 注意: 多个线程写同一位置会有竞争!
    // 实际实现需要atomicAdd或分块统计
    if (pixelIdx == 0u) {
        stats[0] = uint(stepCount);
        stats[1] = uint(depthSkipCount);
        stats[2] = uint(rayLeakCount);
        stats[3] = hit ? 1u : 0u;
    }
}
