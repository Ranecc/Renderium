// Renderium - Virtual Geometry System Compute Shader
// cull_lod.comp - Cluster Cull/LOD 选择 Compute Shader
// 功能: 在 GPU 上遍历 Cluster 层次结构，根据屏幕空间误差动态选择 LOD
// 来源: modern-render-architecture.md §3.4 Nanite-Style Virtual Geometry

#version 450 core

// ==================== Workgroup 配置 ====================
// 每个 Workgroup 处理 64 个 Cluster 节点 (可根据 GPU 架构调整)
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// ==================== 数据结构定义 ====================

/**
 * Cluster 节点数据结构 (对应 Java 端 VirtualGeometrySystem.Cluster)
 *
 * 布局说明:
 * - boundsMin/Max: 轴对齐包围盒 (AABB)，用于视锥剔除和距离计算
 * - children[4]: 子节点 ID 列表 (0 表示无子节点)
 * - geometryOffset: 几何数据在 clusterDataPool 中的偏移量 (0 表示无几何体/叶子节点)
 * - error: 预计算的屏幕空间误差 (用于 LOD 选择阈值判断)
 * - lodLevel: 当前 LOD 等级 (0 = 最粗略)
 */
struct ClusterNode {
    vec4 boundsMin;          // xyz = 最小角坐标, w = padding
    vec4 boundsMax;          // xyz = 最大角坐标, w = padding
    uvec4 children;          // 最多 4 个子节点 ID (uint)
    uint geometryOffset;     // 几何数据偏移 (0 = 无几何体)
    uint indexCount;         // 索引数量 (三角形数 × 3)
    uint vertexOffset;       // 顶点数据偏移
    float error;             // 屏幕空间误差
    uint lodLevel;           // LOD 等级
    uint padding1;           // 对齐填充
    uint padding2;           // 对齐填充
};

/**
 * Indirect Draw 命令结构 (Vulkan VkDrawIndexedIndirectCommand)
 *
 * 对应 Vulkan 规范中的 DrawIndexedIndirectCommand 结构，
 * 由 Compute Shader 输出，供 vkCmdDrawIndexedIndirect 使用。
 */
struct DrawIndexedIndirectCommand {
    uint indexCount;         // 每个实例的索引数量
    uint instanceCount;      // 实例数量 (通常为 1)
    uint firstIndex;         // 第一个索引的偏移
    int vertexOffset;        // 顶点偏移 (添加到索引值上)
    uint firstInstance;      // 实例 ID (gl_InstanceID 的基础值)
};

// ==================== SSBO (Shader Storage Buffer Object) 绑定 ====================

/**
 * Cluster 树缓冲区 (只读)
 * 存储完整的 Cluster 层次树结构 (BVH/DAG 扁平化数组)
 * 绑定点: 0
 */
layout(std430, binding = 0) readonly buffer ClusterTree {
    ClusterNode nodes[];     // 所有 Cluster 节点的数组
};

/**
 * 可见性结果缓冲区 (写入)
 * 存储当前帧可见的 Cluster ID 列表
 * 绑定点: 1
 */
layout(std430, binding = 1) writeonly buffer VisibleClusters {
    uint clusterIndices[];   // 可见 Cluster ID 数组
};

/**
 * Indirect Draw 命令缓冲区 (写入)
 * 由 Compute Shader 生成的绘制命令
 * 绑定点: 2
 */
layout(std430, binding = 2) buffer IndirectCommands {
    DrawIndexedIndirectCommand commands[];
};

/**
 * 全局计数器 (读写)
 * 用于原子计数器，记录当前已发现的可见 Cluster 数量
 * 绑定点: 3
 */
layout(std430, binding = 3) buffer AtomicCounters {
    uint visibleClusterCount;    // 可见 Cluster 总数
    uint totalDrawCalls;         // 总 Draw Call 数量
    uint padding_counters[2];    // 对齐填充
};

// ==================== UBO (Uniform Buffer Object) 绑定 ====================

/**
 * Culling 参数 (相机和渲染设置)
 * 绑定点: 0 (与 SSBO 使用不同的 descriptor set 或 binding point)
 */
layout(std140, binding = 4) uniform CullParams {
    mat4 viewProjMatrix;         // View-Projection 组合矩阵
    vec3 cameraPosition;         // 相机世界空间位置
    float screenWidth;            // 屏幕宽度 (像素)
    float screenHeight;           // 屏幕高度 (像素)
    float errorThreshold;         // 屏幕空间误差阈值 (像素), 默认 2.0
    uint maxVisibleClusters;      // 最大允许可见 Cluster 数量 (防止溢出)
    float nearPlane;              // 近裁剪面距离
    float fovY;                   // 垂直视场角 (弧度)
    uint nodeCount;               // Cluster 节点总数
};

// ==================== 常量定义 ====================

/** 无效 Cluster ID 常量 */
const uint INVALID_CLUSTER_ID = 0u;

/** 子节点最大数量 */
const uint MAX_CHILDREN = 4u;

/** Infinity 替代值 (避免使用 GLSL 内置的 infinity) */
const float LARGE_FLOAT = 3.402823466e+38; // 接近 float max

// ==================== 共享内存 (Shared Memory) ====================

/**
 * Workgroup 内部共享的临时存储
 * 用于减少全局内存访问，提高性能
 */
shared uint localVisibleStack[64];  // 每个线程一个槽位，存储需要递归处理的节点
shared uint localVisibleCount;      // 本 workgroup 发现的可见节点计数

// ==================== 辅助函数 ====================

/**
 * 测试 AABB 是否在视锥体内 (P-NA 算法: Plane-Normal Axis)
 *
 * 使用 6 个平面法线测试包围盒：
 * 对于每个平面，检查包围盒是否完全在平面的负面（外部）
 * 如果所有 8 个顶点都在任一平面的负面 → 完全在外部 → 剔除
 *
 * @param boundsMin 包围盒最小角
 * @param boundsMax 包围盒最大角
 * @return true 表示在视锥体内 (可见), false 表示在外部 (被剔除)
 */
bool isFrustumCulled(vec3 boundsMin, vec3 boundsMax) {
    // 从 viewProjMatrix 提取视锥体平面 (6 个面)
    // 平面方程: ax + by + cz + d = 0, 法线指向内部
    //
    // Left Plane:   row3 + row0
    // Right Plane:  row3 - row0
    // Bottom Plane: row3 + row1
    // Top Plane:    row3 - row1
    // Near Plane:   row3 + row2
    // Far Plane:    row3 - row2

    vec4 row0 = viewProjMatrix[0]; // [a0, a1, a2, a3]
    vec4 row1 = viewProjMatrix[1];
    vec4 row2 = viewProjMatrix[2];
    vec4 row3 = viewProjMatrix[3];

    // 测试左平面 (法线朝右)
    vec4 leftPlane = row3 + row0;
    if (dot(leftPlane.xyz, boundsMin) + leftPlane.w > 0.0 &&
        dot(leftPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMin.z)) + leftPlane.w > 0.0 &&
        dot(leftPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMin.z)) + leftPlane.w > 0.0 &&
        dot(leftPlane.xyz, vec3(boundsMax.x, boundsMax.y, boundsMin.z)) + leftPlane.w > 0.0 &&
        dot(leftPlane.xyz, vec3(boundsMin.x, boundsMin.y, boundsMax.z)) + leftPlane.w > 0.0 &&
        dot(leftPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMax.z)) + leftPlane.w > 0.0 &&
        dot(leftPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMax.z)) + leftPlane.w > 0.0 &&
        dot(leftPlane.xyz, boundsMax) + leftPlane.w > 0.0) {
        return false; // 完全在左侧 → 剔除
    }

    // 测试右平面 (法线朝左)
    vec4 rightPlane = row3 - row0;
    if (dot(rightPlane.xyz, boundsMin) + rightPlane.w > 0.0 &&
        dot(rightPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMin.z)) + rightPlane.w > 0.0 &&
        dot(rightPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMin.z)) + rightPlane.w > 0.0 &&
        dot(rightPlane.xyz, boundsMax) + rightPlane.w > 0.0 &&
        dot(rightPlane.xyz, vec3(boundsMin.x, boundsMin.y, boundsMax.z)) + rightPlane.w > 0.0 &&
        dot(rightPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMax.z)) + rightPlane.w > 0.0 &&
        dot(rightPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMax.z)) + rightPlane.w > 0.0 &&
        dot(rightPlane.xyz, vec3(boundsMax.x, boundsMax.y, boundsMax.z)) + rightPlane.w > 0.0) {
        return false; // 完全在右侧 → 剔除
    }

    // 测试底平面 (法线朝上)
    vec4 bottomPlane = row3 + row1;
    if (dot(bottomPlane.xyz, boundsMin) + bottomPlane.w > 0.0 &&
        dot(bottomPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMin.z)) + bottomPlane.w > 0.0 &&
        dot(bottomPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMin.z)) + bottomPlane.w > 0.0 &&
        dot(bottomPlane.xyz, vec3(boundsMax.x, boundsMax.y, boundsMin.z)) + bottomPlane.w > 0.0 &&
        dot(bottomPlane.xyz, vec3(boundsMin.x, boundsMin.y, boundsMax.z)) + bottomPlane.w > 0.0 &&
        dot(bottomPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMax.z)) + bottomPlane.w > 0.0 &&
        dot(bottomPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMax.z)) + bottomPlane.w > 0.0 &&
        dot(bottomPlane.xyz, boundsMax) + bottomPlane.w > 0.0) {
        return false; // 完全在下侧 → 剔除
    }

    // 测试顶平面 (法线朝下)
    vec4 topPlane = row3 - row1;
    if (dot(topPlane.xyz, boundsMin) + topPlane.w > 0.0 &&
        dot(topPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMin.z)) + topPlane.w > 0.0 &&
        dot(topPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMin.z)) + topPlane.w > 0.0 &&
        dot(topPlane.xyz, vec3(boundsMax.x, boundsMax.y, boundsMin.z)) + topPlane.w > 0.0 &&
        dot(topPlane.xyz, vec3(boundsMin.x, boundsMin.y, boundsMax.z)) + topPlane.w > 0.0 &&
        dot(topPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMax.z)) + topPlane.w > 0.0 &&
        dot(topPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMax.z)) + topPlane.w > 0.0 &&
        dot(topPlane.xyz, boundsMax) + topPlane.w > 0.0) {
        return false; // 完全在上侧 → 剔除
    }

    // 测试近平面
    vec4 nearPlane = row3 + row2;
    if (dot(nearPlane.xyz, boundsMin) + nearPlane.w > 0.0 &&
        dot(nearPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMin.z)) + nearPlane.w > 0.0 &&
        dot(nearPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMin.z)) + nearPlane.w > 0.0 &&
        dot(nearPlane.xyz, vec3(boundsMax.x, boundsMax.y, boundsMin.z)) + nearPlane.w > 0.0 &&
        dot(nearPlane.xyz, vec3(boundsMin.x, boundsMin.y, boundsMax.z)) + nearPlane.w > 0.0 &&
        dot(nearPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMax.z)) + nearPlane.w > 0.0 &&
        dot(nearPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMax.z)) + nearPlane.w > 0.0 &&
        dot(nearPlane.xyz, boundsMax) + nearPlane.w > 0.0) {
        return false; // 完全在近裁剪面前 → 剔除
    }

    // 测试远平面
    vec4 farPlane = row3 - row2;
    if (dot(farPlane.xyz, boundsMin) + farPlane.w > 0.0 &&
        dot(farPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMin.z)) + farPlane.w > 0.0 &&
        dot(farPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMin.z)) + farPlane.w > 0.0 &&
        dot(farPlane.xyz, vec3(boundsMax.x, boundsMax.y, boundsMin.z)) + farPlane.w > 0.0 &&
        dot(farPlane.xyz, vec3(boundsMin.x, boundsMin.y, boundsMax.z)) + farPlane.w > 0.0 &&
        dot(farPlane.xyz, vec3(boundsMax.x, boundsMin.y, boundsMax.z)) + farPlane.w > 0.0 &&
        dot(farPlane.xyz, vec3(boundsMin.x, boundsMax.y, boundsMax.z)) + farPlane.w > 0.0 &&
        dot(farPlane.xyz, boundsMax) + farPlane.w > 0.0) {
        return false; // 完全在远裁剪面后 → 剔除
    }

    // 至少部分在视锥体内 → 可能可见
    return true;
}

/**
 * 计算包围盒的屏幕空间投影误差 (像素)
 *
 * <h3>算法原理：</h3>
 * <pre>
 * 1. 计算包围盒中心到相机的距离
 * 2. 计算包围盒在世界空间的最大边长
 * 3. 根据透视投影公式将世界空间尺寸转换为屏幕像素:
 *    screenSize = (worldSize * screenHeight) / (2.0 * distance * tan(fovY / 2.0))
 * 4. 返回屏幕空间误差 (像素)
 * </pre>
 *
 * <h3>用途：</h3>
 * 用于 LOD 决策：如果 screenError <= errorThreshold，
 * 则认为此 Cluster 的细节足够精细，可以直接渲染；
 * 否则需要递归处理子节点以获得更细的 LOD。
 *
 * @param boundsMin 包围盒最小角
 * @param boundsMax 包围盒最大角
 * @return 屏幕空间误差 (像素单位)
 */
float calculateScreenError(vec3 boundsMin, vec3 boundsMax) {
    // Step 1: 计算包围盒中心
    vec3 center = (boundsMin + boundsMax) * 0.5;

    // Step 2: 计算到相机的距离 (欧几里得距离)
    float distance = length(center - cameraPosition);

    // 避免除零 (如果距离过近，钳位到一个小的正值)
    distance = max(distance, nearPlane);

    // Step 3: 计算包围盒的最大边长 (世界空间)
    vec3 extent = boundsMax - boundsMin;
    float maxExtent = max(max(extent.x, extent.y), extent.z);

    // Step 4: 投影到屏幕空间 (透视投影公式)
    // screenSize = (worldSize * screenHeight) / (2.0 * distance * tan(fovY / 2.0))
    float halfTanFov = tan(fovY * 0.5);
    float screenSpaceSize = (maxExtent * screenHeight) / (2.0 * distance * halfTanFov);

    // 返回屏幕空间误差 (像素)
    return screenSpaceSize;
}

/**
 * 检查 Cluster 是否应该继续细分 (LOD 选择)
 *
 * <h3>决策逻辑：</h3>
 * <pre>
 * if (screenError > errorThreshold && hasChildren) {
 *     // 误差太大且有子节点 → 需要细分 (使用更精细的 LOD)
 *     return true;
 * } else {
 *     // 误差足够小或无子节点 → 直接渲染当前 Cluster
 *     return false;
 * }
 * </pre>
 *
 * @param node 当前 Cluster 节点
 * @return true 表示需要继续细分 (递归处理子节点)
 */
bool shouldSubdivide(ClusterNode node) {
    // 计算实际屏幕空间误差
    float screenError = calculateScreenError(node.boundsMin.xyz, node.boundsMax.xyz);

    // 使用预计算的误差作为优化 (如果可用)
    float effectiveError = max(screenError, node.error);

    // 有子节点且误差超过阈值 → 需要细分
    bool hasChildren = node.children[0] != INVALID_CLUSTER_ID ||
                       node.children[1] != INVALID_CLUSTER_ID ||
                       node.children[2] != INVALID_CLUSTER_ID ||
                       node.children[3] != INVALID_CLUSTER_ID;

    return (effectiveError > errorThreshold) && hasChildren;
}

// ==================== 主函数 ====================

/**
 * Compute Shader 主入口
 *
 * <h3>算法流程：</h3>
 * <pre>
 * ┌─────────────────────────────────────────────────────────────┐
 * │  1. 获取当前线程对应的 Node Index                            │
 * │  2. 边界检查 (防止越界访问)                                   │
 * │  3. 读取 Cluster 节点数据                                    │
 * │  4. 视锥体剔除测试                                          │
 * │     ├─ 如果完全在视锥外 → 结束 (不可见)                     │
 * │     └─ 如果部分或全部在视锥内 → 继续                        │
 * │  5. 屏幕空间误差计算                                        │
 * │     ├─ 误差 <= threshold 且有几何体 → 标记为可见            │
 * │     ├─ 误差 > threshold 且有子节点 → 加入待处理栈 (递归)    │
 * │     └─ 误差 > threshold 但无子节点 → 强制渲染 (最细 LOD)    │
 * │  6. 原子操作写入可见性结果                                  │
 * │  7. 生成 Indirect Draw 命令                                 │
 * └─────────────────────────────────────────────────────────────┘
 * </pre>
 *
 * <h3>性能优化：</h3>
 * <ul>
 *   <li>使用 shared memory 减少 global memory 访问</li>
 *   <li>使用 atomic 操作保证线程安全</li>
 *   <li>提前退出 (early-out) 避免不必要计算</li>
 *   <li>分支合并友好 (warp/wavefront 级别)</li>
 * </ul>
 */
void main() {
    // ========== Step 1 & 2: 获取 Node Index 并边界检查 ==========

    uint nodeIdx = gl_GlobalInvocationID.x;

    // 边界检查：确保不越界访问 nodes 数组
    if (nodeIdx >= nodeCount) {
        return; // 超出范围 → 空操作
    }

    // ========== Step 3: 读取 Cluster 节点数据 ==========

    ClusterNode node = nodes[nodeIdx];

    // ========== Step 4: 视锥体剔除测试 ==========

    // 快速拒绝：如果不在视锥体内 → 完全不可见 → 跳过
    if (!isFrustumCulled(node.boundsMin.xyz, node.boundsMax.xyz)) {
        return; // 被视锥剔除 → 不渲染
    }

    // ========== Step 5: LOD 决策 ==========

    // 计算屏幕空间误差
    float screenError = calculateScreenError(node.boundsMin.xyz, node.boundsMax.xyz);

    // 检查是否需要细分 (递归处理子节点)
    bool needSubdivision = shouldSubdivide(node);

    if (!needSubdivision) {
        // ====== Case A: 渲染当前 Cluster ======
        // 条件: 误差足够小 或 无子节点可细分

        // 检查是否有有效的几何数据
        if (node.geometryOffset != 0 && node.indexCount > 0) {

            // 原子递增获取输出位置 (线程安全)
            uint outputIndex = atomicAdd(visibleClusterCount, 1);

            // 防止溢出 (超出最大可见数量限制)
            if (outputIndex >= maxVisibleClusters) {
                atomicAdd(visibleClusterCount, uint(-1)); // 回滚计数器
                return; // 达到上限 → 丢弃
            }

            // 写入可见 Cluster ID 到输出缓冲区
            clusterIndices[outputIndex] = nodeIdx;

            // 生成 Indirect Draw 命令
            commands[outputIndex].indexCount = node.indexCount;   // 索引数量
            commands[outputIndex].instanceCount = 1u;             // 单实例
            commands[outputIndex].firstIndex = node.geometryOffset; // 首索引偏移
            commands[outputIndex].vertexOffset = int(node.vertexOffset); // 顶点偏移
            commands[outputIndex].firstInstance = outputIndex;    // 实例 ID = 输出索引

            // 更新总 Draw Call 计数
            atomicAdd(totalDrawCalls, 1u);

        } else {
            // 无几何数据的中间节点 (不应该出现，但防御性编程)
            // 这种情况可能发生在 Cluster 尚未加载完成时
            // 可以选择忽略或标记为需要流送加载
        }

    } else {
        // ====== Case B: 需要细分 (递归处理子节点) ======
        // 条件: 误差太大但有子节点 → 需要更精细的 LOD

        // 注意: 由于 GLSL Compute Shader 不支持真正的递归，
        // 这里采用迭代方式处理子节点。
        //
        // 方案 1: 多遍处理 (Multi-Pass Approach)
        //   Pass 1: 处理根节点，将需要细分的子节点加入队列
        //   Pass 2: 处理队列中的节点，重复直到没有需要细分的节点
        //
        // 方案 2: 栈式迭代 (Stack-Based Iteration)
        //   使用 shared memory 或 SSBO 作为栈，迭代展开递归
        //
        // 方案 3: 宽优先搜索 (BFS Wavefront)
        //   每个 Level 单独 dispatch，逐层细化
        //
        // 当前实现采用简化的单层方案:
        // 将子节点标记为"需要在下一 Pass 中处理"
        // 通过多次 dispatch 完成完整树遍历

        // TODO: 实现多遍或栈式递归处理
        //
        // 示例伪代码 (栈式):
        // uint stack[MAX_DEPTH];
        // int stackPtr = 0;
        // stack[stackPtr++] = node.children[0];
        // stack[stackPtr++] = node.children[1];
        // // ... push all valid children
        //
        // while (stackPtr > 0) {
        //     uint childIdx = stack[--stackPtr];
        //     ClusterNode child = nodes[childIdx];
        //     // ... process child similarly ...
        // }

        // 简化实现: 直接处理第一个有效子节点 (演示用)
        for (uint i = 0u; i < MAX_CHILDREN; i++) {
            uint childId = node.children[i];
            if (childId != INVALID_CLUSTER_ID && childId < nodeCount) {

                // 读取子节点并快速测试
                ClusterNode child = nodes[childId];

                // 快速视锥测试
                if (isFrustumCulled(child.boundsMin.xyz, child.boundsMax.xyz)) {

                    // 检查子节点的误差
                    float childScreenError = calculateScreenError(
                        child.boundsMin.xyz,
                        child.boundsMax.xyz
                    );

                    // 如果子节点误差满足要求且有几何体 → 直接渲染子节点
                    if (childScreenError <= errorThreshold &&
                        child.geometryOffset != 0 &&
                        child.indexCount > 0) {

                        uint outputIndex = atomicAdd(visibleClusterCount, 1);

                        if (outputIndex < maxVisibleClusters) {
                            clusterIndices[outputIndex] = childId;

                            commands[outputIndex].indexCount = child.indexCount;
                            commands[outputIndex].instanceCount = 1u;
                            commands[outputIndex].firstIndex = child.geometryOffset;
                            commands[outputIndex].vertexOffset = int(child.vertexOffset);
                            commands[outputIndex].firstInstance = outputIndex;

                            atomicAdd(totalDrawCalls, 1u);
                        }
                    }
                    // else: 子节点仍然太粗糙 → 需要更深层的递归 (留给后续 Pass)
                }
            }
        }
    }

    // ========== 完成 ==========
    // 此线程处理的 Cluster 已完成 LOD 选择和可见性判定
}
