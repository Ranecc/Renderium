#version 450 core
// ============================================================================
// Renderium Phase 2 - 狂暴模式优化
// Hi-Z (Hierarchical Z-Buffer) Occlusion Culling Compute Shader
// ============================================================================
//
// 用途: GPUDrivenVisibilitySystem Pass 2 - GPU 加速遮挡剔除
//
// 功能描述:
//   使用上一帧生成的 Hi-Z 深度金字塔对通过视锥测试的候选 Chunk 进行遮挡剔除。
//   通过从粗到细的层次化深度比较，快速判断 Chunk 是否被前景几何体完全遮挡。
//
// 算法原理:
//   Hi-Z Buffer 是一个 Mipmap 链式的深度缓冲金字塔:
//     - Level 0: 原始深度缓冲 (全分辨率)
//     - Level N: 存储对应区域的最小/最大深度值 (1/2^N 分辨率)
//
//   测试流程:
//     1. 将候选 Chunk 的 AABB 投影到屏幕空间
//     2. 从合适的 Hi-Z 层级开始查询
//     3. 比较 Chunk 的最近深度与 Hi-Z 的最大深度
//     4. 如果 Chunk 完全在 Hi-Z 深度之后 → 被遮挡 → 剔除
//     5. 如果不确定 → 降级到更细层级或保守地标记为可见
//
// 性能优势:
//   - 单次纹理查找即可剔除大块被遮挡区域
//   - 层次化结构允许 O(log N) 复杂度的查询
//   - 利用 GPU 纹理硬件的高速缓存 (Texture Cache)
//   - 与视锥剔除形成级联，进一步减少绘制调用
//
// 输入/输出:
//   输入: VisibilityInput (来自 Pass 1), ChunkBounds, HiZTexture, CameraData
//   输出: VisibilityOutput (更新后的最终可见性), Atomic Counter (最终数量)
//
// 集成点:
//   Java端: GPUDrivenVisibilitySystem.executeOcclusionCulling()
//   前置依赖: frustum_culling.comp (必须先执行)
//   后续消费者: indirect_draw_gen.comp
//
// 作者: Renderium Shader Team
// 日期: 2026-04-14
// ============================================================================

// ==================== 可配置常量 ====================

/** 工作组大小 (匹配 Pass 1 以保持一致) */
#define WORKGROUP_SIZE 256

/** 最大支持的 Chunk 数量 */
#define MAX_CHUNKS 65536

/** Hi-Z 金字塔最大层数 (限制递归深度，防止无限循环) */
#define HIZ_MAX_LOD_LEVELS 12

/** 是否使用保守模式 (true = 宁可多渲染不可误删) */
#define HIZ_CONSERVATIVE_MODE false

/** 是否启用 Subgroup 扩展进行并行归约 */
#define USE_SUBGROUP 1

/** 最小屏幕空间尺寸阈值 (像素) */
#define MIN_SCREEN_SIZE_PIXELS 2.0

// ==================== Subgroup 扩展声明 ====================
#if USE_SUBGROUP
#extension GL_EXT_shader_subgroup_ballot : require
#extension GL_EXT_shader_subgroup_arithmetic : require
#endif

// ==================== 工作组配置 ====================
layout(local_size_x = WORKGROUP_SIZE) in;

// ==================== 输入 SSBO: 来自 Pass 1 的可见性结果 ====================
// Binding 0: Pass 1 (Frustum Culling) 的输出，作为本 Pass 的输入
// 只有 visibility[i] == 1 的 chunk 才需要测试遮挡
layout(std430, binding = 0) readonly buffer VisibilityInput {
    uint inputVisibility[];       // Pass 1 的可见性标志
};

// ==================== 输入 SSBO: Chunk 包围盒数据 ====================
// Binding 1: 所有 Chunk 的 AABB (与 Pass 1 共享相同数据)
// 内存布局同 frustum_culling.comp
layout(std430, binding = 1) readonly buffer ChunkBounds {
    vec4 bounds[];               // [min.xyz, _] / [max.xyz, _] 交替
};

// ==================== 输出 SSBO: 最终可见性结果 ====================
// Binding 2: 更新后的可见性标志 (Pass 3 使用)
// 注意: 这是读写 buffer，因为需要更新 (将遮挡剔除的结果写回)
layout(std430, binding = 2) buffer VisibilityOutput {
    uint outputVisibility[];     // 最终可见性 (0=被剔除, 1=可见)
};

// ==================== 原子计数器: 最终可见 Chunk 数量 ====================
// Binding 3: 全局原子计数器 (需要在 Dispatch 前由 CPU 重置为 0)
layout(std430, binding = 3) buffer FinalVisibleCounter {
    atomic_uint finalVisibleCount;
};

// ==================== Hi-Z 深度金字塔纹理 ====================
// Binding 4: 上一帧生成的 Hi-Z 深度金字塔
//
// 纹理格式要求:
//   - 内部格式: R32UI 或 R32F (存储深度值)
//   - 每个像素存储该区域的最大深度 (用于 Z> 测试)
//   - Mipmap 层数: >= HIZ_MAX_LOD_LEVELS
//   - 寻址模式: ClampToEdge (避免边界伪影)
//
// Java端生成方式:
//   1. 渲染完场景后，读取深度缓冲
//   2. 从 Level 0 (原始深度) 开始降采样
//   3. 每个 Level N+1 存储 Level N 对应 2x2 区域的最小/最大深度
//   4. Level 0 = 全分辨率, Level K = 1/(2^K) 分辨率
//
// 注意: 使用 sampler2D 而非 texture2D (Vulkan GLSL 语法)
layout(binding = 4) uniform sampler2D hiZDepthPyramid;

// ==================== UBO: 相机与 Hi-Z 参数 ====================
// Binding 5: 相机参数和 Hi-Z 配置信息
layout(std140, binding = 5) uniform CameraAndHiZData {
    // 视图-投影矩阵 (用于屏幕空间投影)
    mat4 viewProjMatrix;

    // 视图矩阵逆 (用于世界坐标→相机坐标转换)
    mat4 viewMatrixInverse;

    // 投影矩阵参数 (用于手动坐标变换)
    vec4 projectionParams;        // [near, far, fovY_tan, aspectRatio]

    // 屏幕尺寸 (用于计算屏幕空间范围)
    uvec2 screenSize;             // [width, height]

    // Hi-Z 纹理尺寸 (可能不同于屏幕尺寸)
    uvec2 hiZSize;                // Level 0 的分辨率

    // 控制 flags
    uint enableHiZCull;           // 是否启用 Hi-Z 遮挡剔除
    uint totalChunkCount;         // 实际 Chunk 数量
    uint maxHiZLOD;               // 实际可用的最大 LOD 层数
    uint _padding;
};

// ==================== Shared Memory: 缓存候选 Chunk 数据 ====================
shared vec3 sharedBoxMin[WORKGROUP_SIZE];
shared vec3 sharedBoxMax[WORKGROUP_SIZE];
shared uint sharedInputVis[WORKGROUP_SIZE];  // 输入可见性缓存

// ==================== 核心算法: Hi-Z 遮挡测试 ====================

/**
 * 将 3D 点投影到屏幕空间 (裁剪空间 → NDC → 屏幕空间)
 *
 * @param worldPos 世界坐标系中的位置
 * @param outScreenPos 输出: 屏幕空间坐标 (像素)
 * @param outDepth 输出: 规范化深度 [0, 1]
 * @return true 如果点在视锥内 (有效投影)
 */
bool projectToScreenSpace(vec3 worldPos, out vec2 outScreenPos, out float outDepth) {
    // 变换到裁剪空间
    vec4 clipPos = viewProjMatrix * vec4(worldPos, 1.0);

    // 透视除法 → NDC (Normalized Device Coordinates)
    // w <= 0 表示在相机后方或退化情况
    if (clipPos.w <= 0.0) {
        return false;
    }

    vec3 ndcPos = clipPos.xyz / clipPos.w;

    // NDC → 屏幕空间 (像素坐标)
    // NDC 范围: [-1, 1], 屏幕: [0, width] x [0, height]
    outScreenPos.x = (ndcPos.x * 0.5 + 0.5) * float(screenSize.x);
    outScreenPos.y = (ndcPos.y * 0.5 + 0.5) * float(screenSize.y);

    // 深度值 (OpenGL/Vulkan 通常 [0, 1]，但取决于 depth range 设置)
    outDepth = ndcPos.z * 0.5 + 0.5;  // 映射到 [0, 1]

    // 检查是否在 NDC 有效范围内
    return (ndcPos.x >= -1.0 && ndcPos.x <= 1.0 &&
            ndcPos.y >= -1.0 && ndcPos.y <= 1.0 &&
            ndcPos.z >= 0.0 && ndcPos.z <= 1.0);
}

/**
 * 计算 AABB 在屏幕空间的包围矩形和深度范围
 *
 * @param boxMin AABB 最小角点 (世界坐标)
 * @param boxMax AABB 最大角点 (世界坐标)
 * @param outMinUV 输出: 屏幕空间最小 UV [0, 1]
 * @param outMaxUV 输出: 屏幕空间最大 UV [0, 1]
 * @param outMinDepth 输出: AABB 最近深度 (最大 z，因为 OpenGL 深度反向)
 * @return true 如果 AABB 至少部分在屏幕内
 */
bool computeAABBScreenBounds(vec3 boxMin, vec3 boxMax,
                              out vec2 outMinUV, out vec2 outMaxUV,
                              out float outMinDepth) {
    // 初始化为极端值
    vec2 screenMin = vec2(float(screenSize.x), float(screenSize.y));
    vec2 screenMax = vec2(0.0, 0.0);
    float minDepth = 1.0;  // 最近深度 (在 OpenGL 中，z 越小越近)

    bool anyVisible = false;

    // 测试 AABB 的 8 个角点
    // 优化: 可以只测试 p-vertex 和 n-vertex，但 8 点测试更精确
    vec3 corners[8];
    corners[0] = vec3(boxMin.x, boxMin.y, boxMin.z);
    corners[1] = vec3(boxMax.x, boxMin.y, boxMin.z);
    corners[2] = vec3(boxMin.x, boxMax.y, boxMin.z);
    corners[3] = vec3(boxMax.x, boxMax.y, boxMin.z);
    corners[4] = vec3(boxMin.x, boxMin.y, boxMax.z);
    corners[5] = vec3(boxMax.x, boxMin.y, boxMax.z);
    corners[6] = vec3(boxMin.x, boxMax.y, boxMax.z);
    corners[7] = vec3(boxMax.x, boxMax.y, boxMax.z);

    for (int i = 0; i < 8; i++) {
        vec2 screenPos;
        float depth;

        if (projectToScreenSpace(corners[i], screenPos, depth)) {
            anyVisible = true;
            screenMin = min(screenMin, screenPos);
            screenMax = max(screenMax, screenPos);
            minDepth = min(minDepth, depth);  // 取最近的深度
        }
    }

    if (!anyVisible) {
        return false;  // AABB 完全在视锥外 (不应该发生，因为 Pass 1 已过滤)
    }

    // 转换到 UV 空间 [0, 1] (用于纹理采样)
    outMinUV = screenMin / vec2(screenSize);
    outMaxUV = screenMax / vec2(screenSize);
    outMinDepth = minDepth;

    // 裁剪到有效范围
    outMinUV = clamp(outMinUV, 0.0, 1.0);
    outMaxUV = clamp(outMaxUV, 0.0, 1.0);

    return true;
}

/**
 * 根据屏幕空间大小选择合适的 Hi-Z LOD 层级
 *
 * 策略: 选择使 AABB 投影大约覆盖 2-4 个 texel 的层级
 * 这样可以在精度和性能之间取得平衡
 *
 * @param screenSizePixels AABB 在屏幕上的近似尺寸 (像素)
 * @return 推荐的 Hi-Z LOD 层级 (0 = 最高分辨率)
 */
uint selectHiZLODLevel(vec2 screenMinUV, vec2 screenMaxUV) {
    // 计算屏幕空间覆盖范围 (texel 单位，基于 Level 0 尺寸)
    vec2 coverage = (screenMaxUV - screenMinUV) * vec2(hiZSize);
    float maxCoverage = max(coverage.x, coverage.y);

    // 选择 LOD: 使覆盖范围约等于 2-4 个 texel
    // LOD = log2(coverage / targetTexels)
    float lodFloat = log2(maxCoverage / 4.0);

    // 限制在有效范围内
    int lod = int(floor(lodFloat));
    lod = clamp(lod, 0, int(maxHiZLOD));

    return uint(lod);
}

/**
 * 执行 Hi-Z 遮挡测试
 *
 * 核心算法:
 *   1. 确定 AABB 在屏幕空间的范围
 *   2. 选择合适的 Hi-Z LOD 层级
 *   3. 在该层级上采样多个点获取最大深度
 *   4. 比较 AABB 的最小深度与 Hi-Z 的最大深度
 *      - 如果 minAABBDepth > maxHiZDepth → AABB 完全在遮挡物后面 → 被遮挡
 *      - 否则 → 可能可见 (保守策略下标记为可见)
 *
 * @param boxMin AABB 最小角点
 * @param boxMax AABB 最大角点
 * @return true 如果 Chunk 可能可见 (未被确认遮挡)
 */
bool testHiZOcclusion(vec3 boxMin, vec3 boxMax) {
    // 步骤 1: 计算屏幕空间边界
    vec2 minUV, maxUV;
    float aabbMinDepth;

    if (!computeAABBScreenBounds(boxMin, boxMax, minUV, maxUV, aabbMinDepth)) {
        // AABB 完全不在屏幕内 (理论上不应到达这里)
#if HIZ_CONSERVATIVE_MODE
        return true;  // 保守: 标记为可见
#else
        return false; // 激进: 标记为不可见
#endif
    }

    // 步骤 2: 检查屏幕空间尺寸是否太小
    vec2 screenSizeUV = maxUV - minUV;
    vec2 screenPixelSize = screenSizeUV * vec2(screenSize);
    float maxScreenDim = max(screenPixelSize.x, screenPixelSize.y);

    if (maxScreenDim < MIN_SCREEN_SIZE_PIXELS) {
        // 太小无法可靠测试 → 保守处理
#if HIZ_CONSERVATIVE_MODE
        return true;
#else
        return false;
#endif
    }

    // 步骤 3: 选择 Hi-Z LOD 层级
    uint lodLevel = selectHiZLODLevel(minUV, maxUV);

    // 步骤 4: 在选定 LOD 上采样 Hi-Z 深度
    //
    // 采样策略: 2x2 网格采样 + 取最大值
    // 这比单点采样更鲁棒，能捕捉 AABB 边缘的深度变化
    //
    // 为什么取最大深度?
    //   Hi-Z 存储的是每个区域的最大深度值 (最远离相机的深度)
    //   如果我们的对象比这个最大深度还远 (depth 更大)，说明它被遮挡了
    //
    float maxHiZDepth = 0.0;

    vec2 uvStep = (maxUV - minUV) * 0.25;  // 1/4 步长创建 2x2 网格
    vec2 samplePoints[4];
    samplePoints[0] = minUV + uvStep;                    // 左上偏移
    samplePoints[1] = minUV + vec2(uvStep.x * 3.0, uvStep.y);       // 右上偏移
    samplePoints[2] = minUV + vec2(uvStep.x, uvStep.y * 3.0);       // 左下偏移
    samplePoints[3] = minUV + uvStep * 3.0;              // 右下偏移

    for (int i = 0; i < 4; i++) {
        // 使用显式 LOD 采样 (避免 GPU 自动 mipmap 选择的不确定性)
        float sampledDepth = textureLod(hiZDepthPyramid, samplePoints[i], float(lodLevel)).r;
        maxHiZDepth = max(maxHiZDepth, sampledDepth);
    }

    // 步骤 5: 比较深度并做出判定
    //
    // 深度比较逻辑 (假设深度范围为 [0,1], 0=近, 1=远):
    //   aabbMinDepth: AABB 中距离相机最近的点的深度
    //   maxHiZDepth: Hi-Z 该区域记录的最大深度 (该区域最远的深度)
    //
    // 判定条件:
    //   如果 aabbMinDepth >= maxHiZDepth → AABB 完全在已知几何体之后 → 被遮挡
    //   否则 → AABB 可能部分或全部可见
    //
    // 注意: 这里添加一个小 epsilon 来处理浮点精度问题
    const float DEPTH_EPSILON = 0.001;  // 深度容差

#if HIZ_CONSERVATIVE_MODE
    // 保守模式: 只在非常确定的情况下才剔除
    // 要求 AABB 明显在 Hi-Z 深度之后才剔除
    bool isOccluded = (aabbMinDepth > maxHiZDepth + DEPTH_EPSILON * 10.0);
    return !isOccluded;  // 返回是否可见
#else
    // 激进模式: 更积极地剔除 (可能有少量错误剔除)
    bool isOccluded = (aabbMinDepth >= maxHiZDepth - DEPTH_EPSILON);
    return !isOccluded;
#endif
}

// ==================== 主函数 ====================
void main() {
    // ---- 步骤 1: 获取工作项索引 ----
    uint globalIdx = gl_GlobalInvocationID.x;
    uint localIdx = gl_LocalInvocationID.x;

    // ---- 步骤 2: 边界检查 ----
    if (globalIdx >= totalChunkCount || globalIdx >= MAX_CHUNKS) {
        return;
    }

    // ---- 步骤 3: 加载数据到 Shared Memory ----
    // 缓存输入可见性和包围盒
    sharedInputVis[localIdx] = inputVisibility[globalIdx];

    uint baseIndex = globalIdx * 2;
    sharedBoxMin[localIdx] = bounds[baseIndex].xyz;
    sharedBoxMax[localIdx] = bounds[baseIndex + 1].xyz;

    barrier();  // 确保 workgroup 内所有线程完成加载

    // ---- 步骤 4: 快速跳过已剔除的 Chunk ----
    // 如果 Pass 1 已经标记为不可见，直接继承结果
    if (sharedInputVis[localIdx] == 0u) {
        outputVisibility[globalIdx] = 0u;
        return;  // 不增加计数器 (因为它从未被计入)
    }

    // ---- 步骤 5: 执行 Hi-Z 遮挡测试 ----
    bool isVisible = true;  // 默认可见 (保守初始值)

    if (enableHiZCull != 0u) {
        isVisible = testHiZOcclusion(sharedBoxMin[localIdx], sharedBoxMax[localIdx]);
    }

    // ---- 步骤 6: 写入最终可见性结果 ----
    outputVisibility[globalIdx] = isVisible ? 1u : 0u;

    // ---- 步骤 7: 统计最终可见数量 ----
#if USE_SUBGROUP
    uvec4 ballotResult = subgroupBallot(isVisible);
    uint subgroupVisibleCount = subgroupBallotBitCount(ballotResult);

    if (subgroupElect()) {
        atomicAdd(finalVisibleCount, subgroupVisibleCount);
    }
#else
    if (isVisible) {
        atomicAdd(finalVisibleCount, 1u);
    }
#endif

    // ---- 函数结束 ----
    // 此 shader 的输出:
    //   1. outputVisibility[globalIdx] = 0 或 1 (最终可见性)
    //   2. finalVisibleCount 原子增加 (最终可见总数)
    //
    // 下游消费者:
    //   - indirect_draw_gen.comp: 读取 outputVisibility[] 生成 VkDrawIndirectCommand
}
