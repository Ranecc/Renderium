#version 450 core
// ============================================================================
// Renderium Phase 2 - 狂暴模式优化
// Indirect Draw Command Generator Compute Shader (间接绘制命令生成器)
// ============================================================================
//
// 用途: GPUDrivenVisibilitySystem Pass 3 - 生成 GPU-Driven 绘制命令
//
// 功能描述:
//   根据前两轮剔除的最终可见性结果，紧凑化可见 Chunk 列表并生成
//   VkDrawIndirectCommand / VkDrawIndexedIndirectCommand 结构体数组。
//   这些命令可以直接传给 vkCmdDrawIndirectCount() 实现零 CPU 开销渲染。
//
// 算法原理:
//   本 shader 实现一个并行前缀和 (Parallel Prefix Sum / Scan) 变体:
//     1. 每个 workgroup 先统计内部可见数量
//     2. 使用原子操作获取全局偏移
//     3. 将可见 Chunk 的绘制命令写入连续数组
//
//   输出格式符合 Vulkan VkDrawIndirectCommand 规范:
//     struct VkDrawIndirectCommand {
//         uint32_t indexCount;      // 每个实例的索引数
//         uint32_t instanceCount;   // 实例数 (通常为 1)
//         uint32_t firstIndex;      // 索引缓冲起始偏移
//         int32_t  vertexOffset;    // 顶点缓冲添加到索引值的偏移
//         uint32_t firstInstance;   // 实例 ID (用于 Instance Shader)
//     };  // 总计 20 字节
//
// 性能优化策略:
//   - Subgroup Ballot + ExclusiveScan 实现 O(1) 局部压缩
//   - 单次全局原子操作获取 workgroup 偏移 (而非每个线程)
 *   - Shared Memory 缓存减少全局内存访问
//   - 支持 vkCmdDrawIndirectCount 的计数 buffer 输出
//
// 关键优势:
//   - CPU 完全不参与 Draw Call 决策
//   - 生成的命令可直接用于 MultiDrawIndirect
//   - 支持动态可见性变化 (每帧重新生成)
//
// 输入/输出:
//   输入: VisibilityBuffer, ChunkMetaData (mesh 信息)
//   输出: IndirectDrawCommands[], DrawCountBuffer (用于 Count 变体)
//
// 集成点:
//   Java端: GPUDrivenVisibilitySystem.generateIndirectDrawCommands()
//   渲染调用: vkCmdDrawIndirectCount(commandBuffer, indirectBuffer,
//                                     offsetOfDrawCount, countBuffer,
//                                     offsetOfCount, maxDrawCount, stride)
//
// 作者: Renderium Shader Team
// 日期: 2026-04-14
// ============================================================================

// ==================== 可配置常量 ====================

/** 工作组大小 */
#define WORKGROUP_SIZE 256

/** 最大支持的 Chunk 数量 */
#define MAX_CHUNKS 65536

/** 最大输出绘制命令数 (= MAX_CHUNKS，最坏情况全部可见) */
#define MAX_DRAW_COMMANDS MAX_CHUNKS

/** 是否使用 Subgroup 扩展进行高效并行压缩 */
#define USE_SUBGROUP 1

/** 是否启用调试统计信息输出 */
#define ENABLE_DEBUG_STATS 0

// ==================== Subgroup 扩展声明 ====================
#if USE_SUBGROUP
#extension GL_EXT_shader_subgroup_ballot : require
#extension GL_EXT_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_subgroup_shuffle : require
#endif

// ==================== 工作组配置 ====================
layout(local_size_x = WORKGROUP_SIZE) in;

// ==================== 输入 SSBO: 最终可见性标志 ====================
// Binding 0: 来自 Pass 2 (Hi-Z Occlusion Culling) 的最终结果
layout(std430, binding = 0) readonly buffer VisibilityInput {
    uint visibility[];            // 0=被剔除, 1=可见
};

// ==================== 输入 SSBO: Chunk 元数据/网格信息 ====================
// Binding 1: 每个 Chunk 的绘制参数 (预计算，Chunk 加载时填充)
//
// 内存布局: 每个 Chunk 一个 ChunkDrawInfo 结构体
//
// struct ChunkDrawInfo {
//     uint indexCount;        // 该 Chunk 的索引数量
//     uint firstIndex;        // 在全局索引缓冲中的起始位置
//     int  vertexOffset;      // 在全局顶点缓冲中的顶点偏移
//     uint chunkId;           // 原始 Chunk ID (用于调试)
// };
// // 总计 16 字节
//
// Java端填充说明:
//   - indexCount: 从 ChunkRenderData.indexCount 获取
//   - firstIndex: 累加所有之前 Chunk 的 indexCount 得到的偏移
//   - vertexOffset: 累加所有之前 Chunk 的 vertexCount 得到的偏移
//   - chunkId: Chunk 的唯一标识符
//
layout(std430, binding = 1) readonly buffer ChunkMetaData {
    // 使用 uvec4 打包以提高内存访问效率 (16 字节对齐)
    // .x = indexCount
    // .y = firstIndex
    // .z = vertexOffset (作为 uint 存储，需要时转换为 int)
    // .w = chunkId
    uvec4 chunkDrawInfo[];
};

// ==================== 输出 SSBO: 间接绘制命令数组 ====================
// Binding 2: 生成的 VkDrawIndirectCommand 数组 (紧密排列)
//
// 内存布局: 符合 Vulkan 规范的 VkDrawIndirectCommand 结构体
//   offset + 0:  indexCount     (uint32, 4 bytes)
//   offset + 4:  instanceCount  (uint32, 4 bytes)  ← 固定为 1
//   offset + 8:  firstIndex     (uint32, 4 bytes)
//   offset + 12: vertexOffset   (int32,  4 bytes)
//   offset + 16: firstInstance  (uint32, 4 bytes)
//   总计: 20 字节 / command
//
// 注意: 虽然结构体是 20 字节，但为了对齐通常按 16 或 32 字步进
//       Vulkan 要求 stride >= sizeof(VkDrawIndirectCommand) = 20
//
layout(std430, binding = 2) writeonly buffer IndirectDrawOutput {
    uint drawCommands[];          // 紧密打包的绘制命令数据
};

// ==================== 输出 SSBO: 绘制命令计数 ====================
// Binding 3: 用于 vkCmdDrawIndirectCount 的计数 buffer
// 存储实际生成的有效绘制命令数量
layout(std430, binding = 3) buffer DrawCountOutput {
    uint drawCount;               // 有效绘制命令总数
};

// ==================== UBO: 控制参数 ====================
// Binding 4: 配置参数
layout(std140, binding = 4) uniform GeneratorParams {
    uint totalChunkCount;         // 实际处理的 Chunk 数量
    uint maxOutputCommands;       // 最大允许输出命令数 (防止溢出)
    uint commandStride;           // 绘制命令步长 (字节)，通常是 20 或 32
    uint _padding;
};

// ==================== 输出 SSBO: 调试统计信息 ====================
// Binding 5: 调试/统计数据输出
// 存储每个 workgroup 级别的统计信息，用于性能分析和调试
// layout: [totalVisible, workgroupCount, _pad0, _pad1]
layout(std430, binding = 5) writeonly buffer DebugStatsOutput {
    uint debugStats[];             // 调试统计数据
};

// ==================== Shared Memory: 工作组内部状态 ====================
shared uint localVisibleMask[WORKGROUP_SIZE / 32];  // Subgroup 可见性位掩码
shared uint localVisibleCount;                       // 本工作组可见数量
shared uint globalBaseIndex;                         // 本工作组在输出中的起始偏移

#if USE_SUBGROUP
// Subgroup 内部的紧凑索引
shared uint subgroupOffsets[WORKGROUP_SIZE / 32];    // 每个 subgroup 的起始偏移
#endif

// ==================== 主函数 ====================
void main() {
    uint globalIdx = gl_GlobalInvocationID.x;
    uint localIdx = gl_LocalInvocationID.x;

    // ---- 步骤 1: 边界检查 ----
    if (globalIdx >= totalChunkCount || globalIdx >= MAX_CHUNKS) {
        return;
    }

    // ---- 步骤 2: 读取可见性 ----
    bool isVisible = (visibility[globalIdx] != 0u);

    // ---- 步骤 3: Subgroup 并行压缩 ----
    //
    // 目标: 计算当前线程在可见列表中的局部位置
    //
    // 算法流程:
    //   a. Subgroup Ballot: 收集 32 个线程的可见性到 64-bit 位掩码
    //   b. Exclusive Bit Count: 计算当前线程之前有多少个可见线程
    //   c. 这就是当前线程在 subgroup 内的"紧凑索引"
    //
#if USE_SUBGROUP
    // Step 3a: 收集 subgroup 可见性
    uvec4 ballot = subgroupBallot(isVisible);

    // Step 3b: 计算排他性前缀和 (exclusive scan)
    // 返回值: 当前 invocation 之前有多少个 invocation 的 ballot 为 true
    uint localIndex = subgroupBallotExclusiveBitCount(ballot);

    // Step 3c: 计算 subgroup 内可见总数
    uint subgroupTotal = subgroupBallotBitCount(ballot);

    // Step 3d: 只有 elected thread 负责 subgroup 级别的统计
    uint subgroupID = gl_SubgroupInvocationID / 32u;  // 通常只有一个 subgroup per workgroup
    // 注意: 如果 WORKGROUP_SIZE > subgroupSize，需要处理多个 subgroup

    if (subgroupElect()) {
        // elected thread: 原子分配本 subgroup 的全局输出范围
        uint allocatedOffset = atomicAdd(drawCount, subgroupTotal);
        subgroupOffsets[subgroupID] = allocatedOffset;

        // 同时记录工作组级别的统计 (可选)
        atomicMax(localVisibleCount, subgroupTotal);  // 简化: 直接存储
    }

    // 等待 elected thread 完成
    barrier();

    // Step 3e: 计算最终的全局输出索引
    uint outputIndex = subgroupOffsets[subgroupID] + localIndex;

#else
    // 无 Subgroup 支持时的回退方案: 逐线程原子操作
    uint outputIndex;

    if (isVisible) {
        outputIndex = atomicAdd(drawCount, 1u);
    } else {
        outputIndex = MAX_DRAW_COMMANDS;  // 无效索引，不会被写入
    }
#endif

    // ---- 步骤 4: 写入间接绘制命令 ----
    if (isVisible && outputIndex < maxOutputCommands) {
        // 读取该 Chunk 的元数据
        uvec4 info = chunkDrawInfo[globalIdx];

        // 解包元数据
        uint indexCount   = info.x;   // 索引数量
        uint firstIndex   = info.y;   // 索引缓冲偏移
        int  vertexOffset = int(info.z);  // 顶点偏移 (有符号)
        uint chunkId      = info.w;   // Chunk ID

        // 计算写入位置 (以 uint 为单位的偏移)
        // 每个 VkDrawIndirectCommand 是 5 个 uint (20 字节)
        uint baseWordOffset = outputIndex * (commandStride / 4u);

        // 写入 VkDrawIndirectCommand 的各个字段
        // 注意: 这里假设 drawCommands[] 是 uint 数组，手动写入各字段
        drawCommands[baseWordOffset + 0] = indexCount;       // indexCount
        drawCommands[baseWordOffset + 1] = 1u;                // instanceCount (固定为 1)
        drawCommands[baseWordOffset + 2] = firstIndex;        // firstIndex
        drawCommands[baseWordOffset + 3] = uint(vertexOffset); // vertexOffset (存储为 uint)
        drawCommands[baseWordOffset + 4] = outputIndex;       // firstInstance (使用紧凑索引作为 instance ID)

        // ---- 可选: 调试信息输出 ----
#if ENABLE_DEBUG_STATS
        // 可以额外写入调试 buffer，记录哪些 chunk 被包含
        // 例如: debugOutput[outputIndex] = chunkId;
#endif
    }

    // ---- 函数结束 ----
    // 此 shader 的输出:
    //   1. drawCommands[]: 紧凑排列的 VkDrawIndirectCommand 数组
    //   2. drawCount: 有效命令数量 (用于 vkCmdDrawIndirectCount)
    //
    // 使用方式 (Vulkan):
    //   vkCmdDrawIndirectCount(
    //       commandBuffer,          // 命令缓冲
    //       indirectDrawBuffer,    // 绑定此 SSBO 的 VkBuffer
    //       0,                     // drawCommands 起始偏移
    //       countBuffer,           // 同一 SSBO 或单独的 count buffer
    //       offsetof(DrawCountOutput, drawCount),  // drawCount 偏移
    //       maxDrawCommands,       // 最大命令数 (安全限制)
    //       commandStride          // 命令步长 (20 或 32)
    //   );
}
