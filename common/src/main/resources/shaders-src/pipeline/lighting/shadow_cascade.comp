#version 460
// Renderium - 级联阴影贴图 (CSM) Compute Shader
// 输入: SSBO 顶点位置, Push Constant (单级联 light VP 矩阵)
// 输出: 单张 R32_SFLOAT storage image (当前 cascade depth)
// workgroup: 64 threads

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, std430) readonly buffer VertexBuffer {
    vec4 positions[];
} vtxBuf;

layout(binding = 1, r32f) uniform image2D uCascadeDepth;

layout(push_constant) uniform PushConstants {
    vec4 lightVP[4]; // 单组 light VP 矩阵 (16 floats, column-major, 64 bytes)
} pc;

void main() {
    uint vtxIdx = gl_GlobalInvocationID.x;
    if (vtxIdx >= vtxBuf.positions.length()) return;

    vec3 worldPos = vtxBuf.positions[vtxIdx].xyz;

    // 变换到裁剪空间
    vec4 clipPos;
    clipPos.x = dot(pc.lightVP[0], vec4(worldPos, 1.0));
    clipPos.y = dot(pc.lightVP[1], vec4(worldPos, 1.0));
    clipPos.z = dot(pc.lightVP[2], vec4(worldPos, 1.0));
    clipPos.w = dot(pc.lightVP[3], vec4(worldPos, 1.0));

    vec3 ndc = clipPos.xyz / max(clipPos.w, 1e-8);
    vec2 uv = ndc.xy * 0.5 + 0.5;

    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return;
    float depth = ndc.z;
    if (depth < 0.0 || depth > 1.0) return;

    uvec2 imgSize = imageSize(uCascadeDepth);
    ivec2 texel = ivec2(uv * vec2(imgSize));
    float current = imageLoad(uCascadeDepth, texel).r;
    if (depth < current || current == 0.0) {
        imageStore(uCascadeDepth, texel, vec4(depth, 0, 0, 0));
    }
}
