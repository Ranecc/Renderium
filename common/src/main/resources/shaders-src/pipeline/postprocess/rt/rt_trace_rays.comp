#version 460
// RayTracingNode - 光线追踪回退 Compute Shader
// 当 Vulkan RT 扩展不可用时，使用屏幕空间反射作为回退
// 输入: G-Buffer (position, normal, albedo), 输出: noisy reflection (RGBA16F)
// workgroup: 8x8

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba32f) uniform readonly image2D uPosition;
layout(binding = 1, rgba16f) uniform readonly image2D uNormal;
layout(binding = 2, rgba8) uniform readonly image2D uAlbedo;
layout(binding = 3, rgba16f) uniform writeonly image2D uOutput;

layout(push_constant) uniform PushConstants {
    int raysPerPixel;
    float maxDistance;
    float invMaxDistance;
    float rayTMax;
} pc;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    uvec2 sz = imageSize(uOutput);
    if (texel.x >= int(sz.x) || texel.y >= int(sz.y)) return;

    vec3 worldPos = imageLoad(uPosition, texel).xyz;
    vec3 normal = normalize(imageLoad(uNormal, texel).xyz * 2.0 - 1.0);
    vec3 albedo = imageLoad(uAlbedo, texel).rgb;
    if (length(worldPos) < 0.001) {
        imageStore(uOutput, texel, vec4(0.0));
        return;
    }

    vec3 viewDir = normalize(-worldPos);
    vec3 reflDir = reflect(viewDir, normal);

    vec3 accum = vec3(0.0);
    int count = 0;
    for (int i = 0; i < pc.raysPerPixel; i++) {
        float d = float(i + 1) * pc.invMaxDistance * 100.0;
        if (d > pc.maxDistance) break;
        vec3 samplePos = worldPos + reflDir * d;
        vec2 sampleUV = (vec2(texel) + 0.5 + reflDir.xy * d * 0.0005) / vec2(sz);
        ivec2 st = ivec2(sampleUV * vec2(sz));
        if (st.x < 0 || st.x >= int(sz.x) || st.y < 0 || st.y >= int(sz.y)) break;
        vec3 sp = imageLoad(uPosition, st).xyz;
        if (abs(length(sp - samplePos)) < 1.0) {
            accum += imageLoad(uNormal, st).xyz * 0.5 + 0.5;
            count++;
        }
    }

    vec3 result = count > 0 ? (accum / float(count)) * albedo : vec3(0.0);
    imageStore(uOutput, texel, vec4(result, 1.0));
}
