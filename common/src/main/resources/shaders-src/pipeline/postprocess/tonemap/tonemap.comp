#version 460
// Renderium - 色调映射 Compute Shader
// 输入: HDR color (rgba16f), 输出: LDR (rgba8)
// 6 步: 曝光 → ACES/Reinhard/Uncharted2 → 饱和度 → 对比度 → 暗角 → Gamma
// workgroup: 8x8

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform readonly image2D uHDRScene;
layout(binding = 1, rgba8) uniform writeonly image2D uLDROutput;

layout(push_constant) uniform PushConstants {
    float exposure;
    float gamma;
    int tonemapType;    // 0=ACES, 1=Reinhard, 2=Uncharted2
    float saturation;
    float contrast;
    float vignetteStrength;
    float pad0;
    float pad1;
} pc;

float luminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 acesFilmic(vec3 x) {
    float a = 2.51; float b = 0.03; float c = 2.43; float d = 0.59; float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec3 reinhard(vec3 x) {
    return x / (x + vec3(1.0));
}

vec3 uncharted2Filmic(vec3 x) {
    float A = 0.15; float B = 0.50; float C = 0.10; float D = 0.20;
    float E = 0.02; float F = 0.30;
    return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    uvec2 sz = imageSize(uLDROutput);
    if (texel.x >= int(sz.x) || texel.y >= int(sz.y)) return;

    vec3 color = imageLoad(uHDRScene, texel).rgb;

    // Step 1: 曝光
    color *= pc.exposure;

    // Step 2: 色调映射
    if (pc.tonemapType == 0) {
        color = acesFilmic(color);
    } else if (pc.tonemapType == 1) {
        color = reinhard(color);
    } else {
        color = uncharted2Filmic(color);
    }

    // Step 3: 饱和度
    float luma = luminance(color);
    color = mix(vec3(luma), color, pc.saturation);

    // Step 4: 对比度
    color = (color - 0.5) * pc.contrast + 0.5;

    // Step 5: 暗角
    vec2 uv = (vec2(texel) + 0.5) / vec2(sz);
    vec2 vignetteUV = uv * (1.0 - uv.yx);
    float vignette = vignetteUV.x * vignetteUV.y * 16.0;
    vignette = clamp(pow(vignette, pc.vignetteStrength), 0.0, 1.0);
    color *= vignette;

    // Step 6: Gamma 校正
    color = pow(max(color, vec3(0.0)), vec3(1.0 / pc.gamma));

    imageStore(uLDROutput, texel, vec4(clamp(color, 0.0, 1.0), 1.0));
}
