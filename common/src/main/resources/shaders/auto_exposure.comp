#version 460
// ============================================================================
// Renderium - 自动曝光 (Auto Exposure) Compute Shader
// ============================================================================
// 算法: 亮度直方图 (shared memory) → 平均 log luminance → EMA 平滑
// ============================================================================

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// ============================================================================
// 资源绑定:
//   binding 0: 颜色纹理 (sampler2D, COMBINED_IMAGE_SAMPLER)
//   binding 1: 输出存储图像 (writeonly, STORAGE_IMAGE) — 存储曝光后的颜色
// ============================================================================
layout(binding = 0, rgba16f) uniform readonly image2D uColorTexture;
layout(binding = 1, rgba16f) uniform image2D          uOutputImage;

// ============================================================================
// PushConstants (32 bytes)
// ============================================================================
layout(push_constant) uniform PushConstants {
    float speed;            // EMA 平滑速度
    int   frameCount;       // 当前帧计数
    float targetLuminance;  // 目标亮度
    float prevExposure;     // 上一帧曝光值
    int   meteringMode;     // 测光模式: 0=平均, 1=点测光, 2=中央重点
    float minExposure;      // 最小曝光值
    float maxExposure;      // 最大曝光值
    float padding;
} pc;

// ============================================================================
// Shared memory: 256-bin 直方图（每个工作组独立）
// ============================================================================
shared uint histogram[256];

// ============================================================================
// 亮度计算
// ============================================================================
float luminance(vec3 color) {
    return dot(color, vec3(0.2126, 0.7152, 0.0722));
}

// ============================================================================
// 主函数
// ============================================================================
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 imgSize = imageSize(uColorTexture);
    if (pixel.x >= imgSize.x || pixel.y >= imgSize.y) return;

    // 1. 初始化共享内存（第一个线程组）
    uint localIdx = gl_LocalInvocationIndex;
    if (localIdx < 256u) {
        histogram[localIdx] = 0u;
    }
    barrier();

    // 2. 计算像素亮度并填入直方图
    vec3 color = imageLoad(uColorTexture, pixel).rgb;
    float lum = luminance(color);

    // log2 luminance → 0-255 bin index
    float logLum = log2(max(lum, 1e-6));
    // 映射范围 [-16, 4] (对应 2^-16 ~ 2^4) 到 [0, 255]
    float normalizedLog = (logLum + 16.0) / 20.0;
    uint binIndex = uint(clamp(normalizedLog * 255.0, 0.0, 255.0));

    // 中央重点测光加权
    float weight = 1.0;
    if (pc.meteringMode == 2) {
        vec2 uv = (vec2(pixel) + 0.5) / vec2(imgSize);
        vec2 centerDist = uv - vec2(0.5);
        float centerWeight = 1.0 - length(centerDist) * 1.5;
        weight = max(0.1, centerWeight);
    } else if (pc.meteringMode == 1) {
        // 点测光: 仅中心 5% 区域
        vec2 uv = (vec2(pixel) + 0.5) / vec2(imgSize);
        vec2 centerDist = uv - vec2(0.5);
        weight = length(centerDist) < 0.05 ? 1.0 : 0.0;
    }

    // 原子累加到共享内存直方图（带权重）
    if (weight > 0.0) {
        // 多次原子加模拟权重（简化：权重转换为计数倍率）
        uint count = uint(weight * 255.0) + 1u;
        for (uint w = 0u; w < count; w++) {
            atomicAdd(histogram[binIndex], 1u);
        }
    }
    barrier();

    // 3. 计算平均 log luminance（第一个线程）
    float totalLogLum = 0.0;
    float totalPixels = 0.0;

    if (localIdx == 0u) {
        for (int i = 0; i < 256; i++) {
            if (histogram[i] > 0u) {
                float logVal = (float(i) / 255.0) * 20.0 - 16.0;
                totalLogLum += logVal * float(histogram[i]);
                totalPixels += float(histogram[i]);
            }
        }

        float avgLogLum = totalPixels > 0.0 ? totalLogLum / totalPixels : -6.0; // 默认 -6 ≈ 低亮度
        float newExposure = exp2(-avgLogLum) * pc.targetLuminance;

        // 4. EMA 平滑
        float adaptedExposure = newExposure;
        if (pc.frameCount > 1) {
            adaptedExposure = pc.prevExposure + (newExposure - pc.prevExposure) * pc.speed;
        }

        // 5. 钳制
        float finalExposure = clamp(adaptedExposure, pc.minExposure, pc.maxExposure);
    }
    barrier();

    // 6. 应用曝光到当前像素
    // 注意: 在真实实现中 exposure 需要通过 SSBO 或 push constant 回读。
    // 这里使用 prevExposure 作为近似，或通过额外 buffer 传递。
    // 简化版: 使用推入的 prevExposure 值
    float exposure = clamp(pc.prevExposure, pc.minExposure, pc.maxExposure);
    vec4 exposedColor = vec4(color * exposure, 1.0);

    imageStore(uOutputImage, pixel, exposedColor);
}
