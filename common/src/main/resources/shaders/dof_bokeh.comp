#version 450
#extension GL_EXT_nonuniform_qualifier : enable

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D colorImage;
layout(set = 0, binding = 1, r32f) uniform image2D depthImage;

layout(push_constant) uniform PushConstants {
    float focalDistance;
    float aperture;
    float focalLength;
    int bokehSamples;
    float nearPlane;
    float farPlane;
    vec2 invScreenSize;
} pc;

const float GOLDEN_ANGLE = 2.39996323;

float linearizeDepth(float d) {
    return pc.nearPlane * pc.farPlane / (pc.farPlane + d * (pc.nearPlane - pc.farPlane));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(colorImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    float depth = imageLoad(depthImage, pixel).r;
    float linearDepth = linearizeDepth(depth);

    // Circle of Confusion calculation
    float denom = linearDepth * (pc.focalDistance - pc.focalLength);
    float coc = (denom != 0.0) ? abs(pc.aperture * pc.focalLength * (linearDepth - pc.focalDistance) / denom) : 0.0;

    // Early out: no blur needed
    if (coc < 0.5) return;

    vec4 centerColor = imageLoad(colorImage, pixel);
    vec4 result = vec4(0.0);
    float totalWeight = 0.0;

    // Bokeh sampling with golden angle spiral
    int samples = min(pc.bokehSamples, 64);
    for (int i = 0; i < samples; i++) {
        float fi = float(i);
        float r = sqrt(fi / float(samples)) * coc;
        float theta = fi * GOLDEN_ANGLE;

        vec2 offset = vec2(cos(theta), sin(theta)) * r * pc.invScreenSize;
        ivec2 samplePixel = pixel + ivec2(offset * vec2(size));

        if (samplePixel.x < 0 || samplePixel.x >= size.x ||
            samplePixel.y < 0 || samplePixel.y >= size.y) continue;

        vec4 sampleColor = imageLoad(colorImage, samplePixel);
        float sampleDepth = linearizeDepth(imageLoad(depthImage, samplePixel).r);

        // Weight by CoC similarity (avoid bleeding from very different depths)
        float sampleCoc = abs(pc.aperture * pc.focalLength * (sampleDepth - pc.focalDistance) /
                             (sampleDepth * (pc.focalDistance - pc.focalLength)));
        float weight = max(0.0, 1.0 - abs(coc - sampleCoc) / max(coc, 1.0));

        result += sampleColor * weight;
        totalWeight += weight;
    }

    if (totalWeight > 0.0) {
        result /= totalWeight;
        imageStore(colorImage, pixel, result);
    }
}
