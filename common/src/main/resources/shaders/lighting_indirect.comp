#version 460
// LightingNode - 间接光照 (AO-based) Compute Shader
// 输入: G-Buffer (albedo, normal, position, material)
// 输出: 间接光照结果 (RGBA16F)
// workgroup: 8x8

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform readonly image2D uAlbedo;
layout(binding = 1, rgba16f) uniform readonly image2D uNormal;
layout(binding = 2, rgba32f) uniform readonly image2D uPosition;
layout(binding = 3, rgba8) uniform readonly image2D uMaterial;
layout(binding = 4, rgba16f) uniform writeonly image2D uOutput;

layout(push_constant) uniform PushConstants {
    float giBounces;
    float aoOnly;
    float intensity;
    float pad;
} pc;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    uvec2 sz = imageSize(uOutput);
    if (texel.x >= int(sz.x) || texel.y >= int(sz.y)) return;

    vec3 albedo = imageLoad(uAlbedo, texel).rgb;
    vec3 normal = normalize(imageLoad(uNormal, texel).xyz * 2.0 - 1.0);
    vec3 worldPos = imageLoad(uPosition, texel).xyz;
    if (length(worldPos) < 0.001) {
        imageStore(uOutput, texel, vec4(0.0));
        return;
    }

    // 简单半球 AO: 对周围像素采样估算可见性
    float ao = 0.0;
    int samples = int(pc.giBounces * 4.0 + 4.0);
    samples = clamp(samples, 1, 32);
    for (int i = 0; i < samples; i++) {
        float angle = float(i) * 1.256637;
        float dist = 1.0 + float(i % 3);
        ivec2 st = texel + ivec2(int(cos(angle) * dist), int(sin(angle) * dist));
        if (st.x >= 0 && st.x < int(sz.x) && st.y >= 0 && st.y < int(sz.y)) {
            vec3 sp = imageLoad(uPosition, st).xyz;
            vec3 diff = sp - worldPos;
            float nd = max(dot(normal, normalize(diff)), 0.0);
            ao += nd / max(dot(diff, diff), 0.01);
        }
    }
    ao = clamp(ao / float(samples), 0.0, 1.0);

    vec3 indirect = albedo * (1.0 - ao) * pc.intensity;
    imageStore(uOutput, texel, vec4(indirect, 1.0));
}
