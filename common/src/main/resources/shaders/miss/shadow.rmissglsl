// Renderium - Ray Tracing Shaders
// shadow.rmissglsl - 阴影光线未命中着色器
// 功能: 处理阴影光线未命中任何几何体的情况 (表示光线到达光源，未被遮挡)
//
// 扩展要求: GLSL #version 460 + GL_EXT_ray_tracing
// 管线类型: Miss Shader (miss)
// 触发条件: 光线未命中场景中任何几何体时调用

#version 460 core
#extension GL_EXT_ray_tracing : require;

// ==================== Payload 定义 ====================

/**
 * 阴影光线 Payload (与 raygen 和 closesthit 中定义的一致)
 */
layout(location = 0) rayPayloadInEXT ShadowPayload {
    float hitT;       // 命中距离
    bool visible;     // 是否可见
} payload;

// ==================== 描述符绑定 ====================

/**
 * 环境贴图 / 天空盒 (可选)
 * <p>
 * 当阴影光线未命中任何物体时，
 * 可以选择采样环境贴图作为背景色/环境光贡献。
 *
 * <p>对于纯阴影 Pass，通常不需要此数据。
 * 但对于全局光照 Pass，未命中时应返回环境光照信息。
 */
layout(set = 0, binding = 20) uniform samplerCube environmentMap;

/**
 * 渲染参数 UBO (与 raygen 共享)
 */
layout(std140, binding = 4) uniform RenderParams {
    mat4 invViewProjMatrix;
    vec2 screenSize;
    float biasValue;
    uint samplesPerPixel;
    uint maxRecursionDepth;
    float minT;
};

/**
 * 光源参数 UBO (用于计算环境光 fallback)
 */
layout(std140, binding = 3) uniform LightData {
    vec4 lightPosition;
    vec4 lightDirection;
    vec4 lightColor;
    vec4 lightParameters;
};

// ==================== 常量定义 ====================

/** 无穷远距离常量 (表示光线未命中) */
const float INFINITY_DISTANCE = 1.0e20;

// ==================== 辅助函数 ====================

/**
 * 获取天空/背景颜色
 *
 * @param rayDirection 光线方向 (世界空间)
 * @return 环境颜色 (RGB)
 */
vec3 getSkyColor(vec3 rayDirection) {
    // 方法 1: 纯色 (最快)
    // return vec3(0.53, 0.81, 0.92); // 天空蓝

    // 方法 2: 渐变天空 (基于方向)
    float t = 0.5 * (rayDirection.y + 1.0); // 将 Y 映射到 [0, 1]
    vec3 skyTop = vec3(0.2, 0.5, 0.9);      // 顶部颜色 (深蓝)
    vec3 skyBottom = vec3(0.7, 0.85, 1.0);   // 底部颜色 (浅蓝)
    return mix(skyBottom, skyTop, t);

    // 方法 3: 采样环境贴图 (最精确，但需要纹理资源)
    // if (environmentMap != samplerCube(0)) { // 检查有效性
    //     return texture(environmentMap, rayDirection).rgb;
    // }
    // return vec3(0.0); // 默认黑色
}

/**
 * 计算环境光贡献 (Hemispheric Ambient)
 *
 * <p>简单的半球环境光模型：
 * 上半球 = 亮色 (天光)，下半球 = 暗色 (地面反射)</p>
 *
 * @param normal 表面法线
 * @return 环境光颜色
 */
vec3 calculateAmbientLight(vec3 normal) {
    vec3 skyColor = vec3(0.5, 0.7, 1.0);   // 天空色 (冷色调)
    vec3 groundColor = vec3(0.4, 0.35, 0.3); // 地面色 (暖色调)

    // 计算法线的 Y 分量在 [-1, 1] 范围内
    // 映射到 [0, 1] 表示朝上 vs 朝下的比例
    float hemiFactor = normal.y * 0.5 + 0.5;

    return mix(groundColor, skyColor, hemiFactor);
}

// ==================== 主函数 ====================

/**
 * Miss 主入口
 *
 * <h3>触发时机：</h3>
 * 当光线完全穿过场景（未命中任何加速结构中的几何体）时调用。
 * 对于阴影光线而言，这意味着:
 * <ul>
 *   <li><b>光源和表面之间没有遮挡物</b></li>
 *   <li><b>该像素被完全照亮</b></li>
 *   <li><b>Shadow Factor = 1.0</b></li>
 * </ul>
 *
 * <h3>内置可用变量：</h3>
 * <ul>
 *   <li>gl_WorldRayOriginEXT: 光线起点 (世界空间)</li>
 *   <li>gl_WorldRayDirectionEXT: 光线方向 (世界空间)</li>
 *   <li>gl_RayTminEXT / gl_RayTmaxEXT: 光线有效范围</li>
 *   <li>gl_IncomingRayFlagsEXT: 入射光线标志</li>
 * </ul>
 *
 * <h3>处理逻辑：</h3>
 * <pre>
 * 1. 设置 payload.visible = true (未被遮挡)
 * 2. 设置 payload.hitT = 最大距离 (表示"无限远")
 * 3. 可选: 采样环境贴图记录背景色 (用于 GI Pass)
 * </pre>
 */
void main() {
    // ========== 核心逻辑: 标记为可见 ==========

    // 未命中 → 光线成功到达光源 → 该点被照亮
    payload.visible = true;

    // 设置命中距离为无穷大 (表示光线传播到最大距离仍未命中)
    payload.hitT = INFINITY_DISTANCE;

    // ========== 可选: 环境光/背景数据处理 ==========

    // 获取光线方向 (用于环境贴图采样或天空色计算)
    vec3 rayDir = normalize(gl_WorldRayDirectionEXT);

    // [可选] 如果是 GI Pass 而非单纯的 Shadow Pass，
    // 可以在这里返回环境光照信息供后续计算使用
    //
    // 示例: 记录环境色到 Payload 的额外字段
    // (需要扩展 ShadowPayload 结构)
    //
    // payload.environmentColor = getSkyColor(rayDir);
    // payload.ambientContribution = calculateAmbientLight(someNormal);

    // ========== 高级功能: 远距离衰减 ==========

    // [可选] 对于点光源，可以基于距离实现柔和的衰减
    // 即使未命中任何物体，过远的距离也应降低光照强度
    //
    // int lightType = int(lightPosition.w);
    // if (lightType != 1) { // 非方向光
    //     float distance = gl_RayTmaxEXT;
    //     float attenuation = 1.0 / (1.0 + 0.09 * distance + 0.032 * distance * distance);
    //     payload.attenuation = attenuation;
    // }

    // ========== 调试输出 (开发阶段) ==========

    #ifdef DEBUG_SHADOW_RAYS
        // 可以将未命中的光线信息写入调试缓冲区
        // 用于可视化哪些像素的光线逃逸了场景
        //
        // debugBuffer[gl_LaunchIDEXT.xy] = uvec4(
        //     0xFFFFFFFF,           // 特殊标记: MISS
        //     packHalf2x16(rayDir.xy),
        //     packHalf2x16(rayDir.zzz), // 打包 Z 分量
        //     floatBitsToUint(gl_RayTmaxEXT)
        // );
    #endif
}
