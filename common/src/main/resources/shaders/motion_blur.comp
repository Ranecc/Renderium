#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D colorImage;
layout(set = 0, binding = 1, rg16f) uniform image2D velocityImage;

layout(push_constant) uniform PushConstants {
    float intensity;
    int samples;
    float maxVelocity;
    vec2 invScreenSize;
} pc;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(colorImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec2 velocity = imageLoad(velocityImage, pixel).xy * pc.intensity;

    // Clamp velocity
    float velLen = length(velocity);
    if (velLen > pc.maxVelocity) {
        velocity = normalize(velocity) * pc.maxVelocity;
    }

    // Early out: negligible motion
    if (velLen < 0.5) return;

    vec4 result = vec4(0.0);
    float totalWeight = 0.0;

    int s = max(2, pc.samples);
    for (int i = 0; i < s; i++) {
        float t = (float(i) / float(s - 1)) - 0.5; // -0.5 to 0.5
        vec2 offset = velocity * t * pc.invScreenSize * vec2(size);
        ivec2 samplePixel = pixel + ivec2(offset);

        if (samplePixel.x < 0 || samplePixel.x >= size.x ||
            samplePixel.y < 0 || samplePixel.y >= size.y) continue;

        vec4 sampleColor = imageLoad(colorImage, samplePixel);
        float weight = 1.0 - abs(t) * 2.0; // Center-weighted
        result += sampleColor * weight;
        totalWeight += weight;
    }

    if (totalWeight > 0.0) {
        imageStore(colorImage, pixel, result / totalWeight);
    }
}
