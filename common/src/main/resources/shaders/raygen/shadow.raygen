// Renderium - Ray Tracing Shaders
// shadow.raygen - 阴影光线生成着色器
// 功能: 为每个像素发射阴影光线到光源，检测遮挡情况
//
// 扩展要求: GLSL #version 460 + GL_EXT_ray_tracing
// 管线类型: Ray Generation Shader (raygen)
// 输入: G-Buffer (位置、法线) + 光源数据
// 输出: Shadow Factor (0.0 = 完全遮挡, 1.0 = 完全照亮)

#version 460 core
#extension GL_EXT_ray_tracing : require

// ==================== Payload 定义 ====================

/**
 * 阴影光线 Payload (光线携带的数据)
 *
 * <h3>字段说明：</h3>
 * <ul>
 *   <li>hitT: 命中距离 (用于判断是否被遮挡)</li>
 *   <li>visible: 可见性标志 (true = 未遮挡, false = 被遮挡)</li>
 * </ul>
 *
 * <p>注意: Payload 大小应尽量小以提高性能</p>
 */
layout(location = 0) rayPayloadInEXT ShadowPayload {
    float hitT;       // 命中距离 (如果未命中则为最大值)
    bool visible;     // 是否可见 (未被遮挡)
} payload;

/**
 * Shadow Payload 结构定义
 */
struct ShadowPayload {
    float hitT;
    bool visible;
};

// ==================== 描述符绑定 ====================

/**
 * G-Buffer 位置纹理 (世界空间位置)
 * <p>
 * 从 G-Buffer Pass 获取的像素世界空间坐标。
 * 用于计算光线起点和方向。
 */
layout(set = 0, binding = 0) uniform texture2D gBufferPosition;

/**
 * G-Buffer 法线纹理 (世界空间法线)
 * <p>
 * 用于表面光照计算和偏移光线起点 (避免自遮挡 acne)。
 */
layout(set = 0, binding = 1) uniform texture2D gBufferNormal;

/** 深度缓冲区 (用于重建位置，如果 gBufferPosition 不可用) */
layout(set = 0, binding = 2) uniform texture2D depthBuffer;

// ==================== Uniform Buffer: 光源数据 ====================

/**
 * 光源参数 UBO
 * <p>
 * 包含当前 Pass 所需的光源信息。
 * 对于多光源场景，可能需要多个 UBO 或 SSBO。
 */
layout(std140, binding = 3) uniform LightData {
    vec4 lightPosition;      // xyz = 世界空间位置, w = 光源类型 (0=点, 1=方向, 2=聚光)
    vec4 lightDirection;     // xyz = 方向 (对于方向光), w = 保留
    vec4 lightColor;         // rgb = 颜色, a = 强度
    vec4 lightParameters;    // x = 半径/范围, y = 内锥角(cos), z = 外锥角(cos), w = 软阴影大小
};

// ==================== Uniform Buffer: 相机与渲染参数 ====================

/**
 * 渲染参数 UBO
 */
layout(std140, binding = 4) uniform RenderParams {
    mat4 invViewProjMatrix;  // 逆 View-Projection 矩阵 (NDC → World)
    vec2 screenSize;          // 屏幕尺寸 (宽, 高)
    float biasValue;           // 阴影偏移值 (避免自遮挡)
    uint samplesPerPixel;      // 每像素采样数 (SPP)
    uint maxRecursionDepth;    // 最大递归深度
    float minT;                // 光线最小距离 (避免自身相交)
};

// ==================== 辅助函数 ====================

/**
 * 从深度缓冲区重建世界空间位置
 *
 * @param fragCoord 屏幕空间坐标 (像素)
 * @param depth     该像素的深度值
 * @return 世界空间位置
 */
vec3 reconstructWorldPosition(vec2 fragCoord, float depth) {
    // NDC 坐标 [-1, 1]
    vec2 ndc = (fragCoord / screenSize) * 2.0 - 1.0;
    // 注意: Vulkan 的 Y 轴是反转的
    ndc.y = -ndc.y;

    // 裁剪空间坐标
    vec4 clipPos = vec4(ndc, depth, 1.0);

    // 世界空间坐标
    vec4 worldPos = invViewProjMatrix * clipPos;
    return worldPos.xyz / worldPos.w;
}

/**
 * 计算阴影偏移量 (避免自遮挡 acne)
 *
 * <h3>问题：</h3>
 * 由于数值精度限制，从表面发出的光线可能会再次击中同一表面（自遮挡），
 * 导致表面出现不自然的暗纹或条纹状伪影。
 *
 * <h3>解决方案：</h3>
 * 将光线起点沿法线方向偏移一小段距离。
 *
 * @param surfacePosition 表面位置
 * @param normal          表面法线
 * @param lightDir        光线方向 (指向光源)
 * @return 偏移后的光线起点
 */
vec3 applyShadowBias(vec3 surfacePosition, vec3 normal, vec3 lightDir) {
    // 方法 1: 法线偏移 (最常用)
    // 沿法线方向偏移，避免与原表面相交
    float bias = max(biasValue * 0.01, biasValue * (1.0 - dot(normal, lightDir)));
    return surfacePosition + normal * bias;

    // 方法 2: 更高级的偏移 (可替代方法 1):
    // 结合法线和光线方向的复合偏移
    // return surfacePosition + normal * biasValue * 0.01 + lightDir * biasValue * 0.001;
}

/**
 * 生成 Area Light 采样点 (用于软阴影)
 *
 * <h3>算法：</h3>
 * 使用 Poisson Disk 或 Stratified Sampling 在光源区域生成采样点。
 * 这里使用简化的圆盘采样作为示例。
 *
 * @param lightPos   光源中心位置
 * @param lightRight 光源局部 X 轴
 * @param lightUp    光源局部 Y 轴
 * @param radius     光源半径
 * @param sampleIndex 当前采样索引
 * @param totalSamples 总采样数
 * @return 采样点世界坐标
 */
vec3 sampleAreaLight(vec3 lightPos, vec3 lightRight, vec3 lightUp,
                     float radius, int sampleIndex, int totalSamples) {
    // 简化的圆盘采样 (Stratified)
    float u = (float(sampleIndex) + 0.5) / float(totalSamples);
    float angle = u * 6.28318530718; // 2π

    // 使用根号实现均匀分布的圆盘采样
    float r = sqrt((float(sampleIndex) + 0.5) / float(totalSamples)) * radius;

    // 极坐标转笛卡尔坐标
    vec2 offset = vec2(cos(angle), sin(angle)) * r;

    // 转换到世界空间
    return lightPos + lightRight * offset.x + lightUp * offset.y;
}

// ==================== 主函数 ====================

/**
 * RayGen 主入口
 *
 * <h3>执行流程：</h3>
 * <pre>
 * ┌─────────────────────────────────────────────────────────────┐
 * │  1. 计算当前像素的屏幕坐标 (gl_LaunchIDEXT)                 │
 * │  2. 从 G-Buffer 读取位置和法线                               │
 * │  3. 计算光线方向 (像素位置 → 光源位置)                      │
 * │  4. 应用阴影偏移 (避免自遮挡)                                │
 * │  5. 发射阴影光线                                            │
 * │     ├─ 如果命中某物 → payload.visible = false (在阴影中)    │
 * │     └─ 如果未命中 → payload.visible = true  (照亮)          │
 * │  6. 写入输出图像 (Shadow Map / Visibility Buffer)            │
 * └─────────────────────────────────────────────────────────────┘
 * </pre>
 *
 * <h3>输出：</h3>
 * <ul>
 *   <li>硬阴影: 二值结果 (0.0 或 1.0)</li>
 *   <li>软阴影: 多次采样的平均值 (0.0 ~ 1.0)</li>
 * </ul>
 */
void main() {
    // ========== Step 1: 计算屏幕坐标 ==========
    // gl_LaunchIDEXT: 当前 invocation 在网格中的坐标 (像素单位)
    vec2 launchID = vec2(gl_LaunchIDEXT.xy);

    // ========== Step 2: 从 G-Buffer 读取几何数据 ==========

    // 读取世界空间位置
    vec3 worldPosition = texture(gBufferPosition, launchID / screenSize).xyz;

    // 读取世界空间法线
    vec3 worldNormal = texture(gBufferNormal, launchID / screenSize).xyz;
    worldNormal = normalize(worldNormal); // 确保归一化

    // 读取深度 (备用方案)
    float depth = texture(depthBuffer, launchID / screenSize).r;

    // 如果位置无效 (背景/天空盒)，跳过
    if (depth >= 1.0) {
        // 背景像素不需要阴影 → 标记为完全照亮
        imageStore(outputImage, ivec2(gl_LaunchIDEXT.xy), vec4(1.0));
        return;
    }

    // 备用: 从深度重建位置 (如果 gBufferPosition 不可用)
    if (length(worldPosition) < 0.001) { // 近似零向量表示无效
        worldPosition = reconstructWorldPosition(launchID, depth);
    }

    // ========== Step 3: 计算光线方向 ==========

    // 光线方向 (从表面指向光源)
    vec3 toLight;

    // 根据光源类型选择方向计算方式
    int lightType = int(lightPosition.w);

    if (lightType == 1) {
        // 方向光 (如太阳光): 所有像素的光线方向相同
        toLight = normalize(-lightDirection.xyz);
    } else {
        // 点光源/聚光灯: 方向指向光源位置
        vec3 lightPos = lightPosition.xyz;
        toLight = normalize(lightPos - worldPosition);
    }

    // ========== Step 4: 应用阴影偏移 ==========
    vec3 rayOrigin = applyShadowBias(worldPosition, worldNormal, toLight);

    // ========== Step 5: 发射阴影光线 ==========

    // 初始化 payload
    payload.hitT = 0.0;
    payload.visible = true; // 默认假设可见 (未遮挡)

    // 计算光线最大距离 (到光源的距离)
    float maxDistance;

    if (lightType == 1) {
        // 方向光: 最大距离设为很大的值
        maxDistance = 10000.0;
    } else {
        // 点光源: 到光源的实际距离
        maxDistance = length(lightPosition.xyz - worldPosition);
    }

    // 发射光线 (单次采样 - 硬阴影)
    traceRayEXT(
        topLevelAS,              // 顶层加速结构
        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsOpaqueEXT |
        gl_RayFlagsSkipClosestHitShaderEXT,  // 光线标志 (阴影只需 Any-Hit)
        0xFF,                     // Cull Mask (测试所有实例)
        0,                        // SBT Offset (RayGen 组内偏移)
        0,                        // SBT Stride (Hit Group 间距)
        0,                        // Miss Index (Miss 组索引)
        rayOrigin,               // 光线起点
        minT,                     // 最小距离 (避免自身相交)
        toLight,                  // 光线方向
        maxDistance,              // 最大距离
        0                         // Payload 索引 (location = 0)
    );

    // ========== Step 6: 写入输出 ==========

    // 计算阴影因子
    float shadowFactor = payload.visible ? 1.0 : 0.0;

    // 多次采样支持 (软阴影)
    // TODO: 循环发射多条光线并平均结果
    // for (int i = 1; i < samplesPerPixel; i++) {
    //     vec3 samplePos = sampleAreaLight(...);
    //     vec3 sampleDir = normalize(samplePos - rayOrigin);
    //     traceRayEXT(...);
    //     shadowFactor += payload.visible ? 1.0 : 0.0;
    // }
    // shadowFactor /= float(samplesPerPixel);

    // 写入输出图像 (Shadow Map / Visibility Buffer)
    // layout(r32f) uniform image2D outputImage; // 应在管线布局中声明
    imageStore(
        outputImage,
        ivec2(gl_LaunchIDEXT.xy),
        vec4(shadowFactor, 0.0, 0.0, 1.0)  // R = 阴影因子
    );
}
