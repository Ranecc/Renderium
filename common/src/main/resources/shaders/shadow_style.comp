#version 460
// ShadowStyleNode - 阴影风格 Compute Shader
// 输入: shadow map depth (R32F), 输出: 风格化阴影 (RGBA8)
// 工作: 读取深度 → 应用边缘柔化 + 颜色染色
// workgroup: 8x8

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, r32f) uniform readonly image2D uShadowDepth;
layout(binding = 1, rgba8) uniform writeonly image2D uOutput;

layout(push_constant) uniform PushConstants {
    int styleFlag;       // 0=硬阴影, 1=软阴影, 2=彩色, 3=PCF
    float edgeSoftness;
    float shadowR;
    float shadowG;
    float shadowB;
} pc;

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    uvec2 sz = imageSize(uOutput);
    if (texel.x >= int(sz.x) || texel.y >= int(sz.y)) return;

    float depth = imageLoad(uShadowDepth, texel).r;
    float shadow = 1.0;

    if (pc.styleFlag == 1 || pc.styleFlag == 3) {
        float sum = 0.0;
        int k = int(pc.edgeSoftness * 2.0 + 1.0);
        k = clamp(k, 1, 8);
        for (int dy = -k; dy <= k; dy++) {
            for (int dx = -k; dx <= k; dx++) {
                ivec2 st = texel + ivec2(dx, dy);
                if (st.x >= 0 && st.x < int(sz.x) && st.y >= 0 && st.y < int(sz.y)) {
                    sum += imageLoad(uShadowDepth, st).r;
                }
            }
            sum += depth;
        }
        float count = float((2*k+1)*(2*k+1) + 1);
        shadow = sum / count;
    } else {
        shadow = depth;
    }

    float darkness = 1.0 - clamp(shadow, 0.0, 1.0);
    vec3 color = mix(vec3(pc.shadowR, pc.shadowG, pc.shadowB), vec3(1.0), 1.0 - darkness);
    imageStore(uOutput, texel, vec4(color, 1.0));
}
