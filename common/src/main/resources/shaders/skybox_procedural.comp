#version 460
// SkyBoxNode - 程序化天空 Compute Shader
// 无输入纹理, 输出: 天空颜色 (RGBA16F)
// workgroup: 8x8

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0, rgba16f) uniform writeonly image2D uOutput;

layout(push_constant) uniform PushConstants {
    float sunAngle;
    float turbidity;
    float exposure;
    float pad;
} pc;

vec3 atmosphericColor(vec3 dir, vec3 sunDir) {
    float sunDot = max(dot(dir, sunDir), 0.0);
    float scatter = exp(-pc.turbidity * 2.0 * (1.0 - sunDot));
    vec3 skyColor = mix(vec3(0.4, 0.6, 1.0), vec3(0.1, 0.1, 0.2), dir.y * 0.5 + 0.5);
    vec3 sunColor = vec3(1.0, 0.9, 0.7) * pow(sunDot, 64.0) * 8.0 + vec3(1.0, 0.7, 0.3) * pow(sunDot, 4.0) * 2.0;
    vec3 horizonGlow = vec3(1.0, 0.7, 0.4) * exp(-(1.0 - abs(dir.y)) * 3.0) * 0.3;
    return (skyColor + horizonGlow + sunColor) * pc.exposure;
}

void main() {
    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    uvec2 sz = imageSize(uOutput);
    if (texel.x >= int(sz.x) || texel.y >= int(sz.y)) return;

    vec2 uv = (vec2(texel) + 0.5) / vec2(sz);
    float theta = uv.x * 6.2831853;
    float phi = (1.0 - uv.y) * 3.14159265;

    vec3 dir = vec3(sin(phi) * cos(theta), cos(phi), sin(phi) * sin(theta));
    vec3 sunDir = normalize(vec3(cos(pc.sunAngle), 0.3, sin(pc.sunAngle)));

    vec3 color = atmosphericColor(dir, sunDir);
    imageStore(uOutput, texel, vec4(color, 1.0));
}
