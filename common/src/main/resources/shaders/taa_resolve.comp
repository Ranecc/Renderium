#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) readonly uniform image2D currentColor;
layout(set = 0, binding = 1, rgba16f) readonly uniform image2D historyColor;
layout(set = 0, binding = 2, rg16f) readonly uniform image2D velocityImage;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D outputColor;

layout(push_constant) uniform PushConstants {
    float blendWeight;
    float sharpness;
    int clampMode; // 0=none, 1=clamp, 2=varianceClip
    vec2 invScreenSize;
    vec2 jitterOffset;
} pc;

// 3x3 neighborhood min/max for variance clipping
void neighborhoodMinMax(ivec2 pixel, ivec2 size, out vec3 colorMin, out vec3 colorMax) {
    colorMin = vec3(1e6);
    colorMax = vec3(-1e6);

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 p = clamp(pixel + ivec2(x, y), ivec2(0), size - ivec2(1));
            vec3 c = imageLoad(currentColor, p).rgb;
            colorMin = min(colorMin, c);
            colorMax = max(colorMax, c);
        }
    }
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(currentColor);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    vec3 current = imageLoad(currentColor, pixel).rgb;
    vec2 velocity = imageLoad(velocityImage, pixel).xy;

    // Reproject: sample history at previous frame position
    vec2 prevUV = (vec2(pixel) + 0.5 - velocity * vec2(size)) / vec2(size);
    ivec2 historyPixel = ivec2(prevUV * vec2(size));

    vec3 history = vec3(0.0);
    bool validHistory = historyPixel.x >= 0 && historyPixel.x < size.x &&
                        historyPixel.y >= 0 && historyPixel.y < size.y;

    if (validHistory) {
        history = imageLoad(historyColor, historyPixel).rgb;

        // Neighborhood clamping / variance clipping
        if (pc.clampMode >= 1) {
            vec3 colorMin, colorMax;
            neighborhoodMinMax(pixel, size, colorMin, colorMax);

            if (pc.clampMode == 2) {
                // Variance clip: extend min/max by variance
                vec3 mean = (colorMin + colorMax) * 0.5;
                vec3 variance = (colorMax - colorMin) * 0.5;
                colorMin = mean - variance * 1.5;
                colorMax = mean + variance * 1.5;
            }

            history = clamp(history, colorMin, colorMax);
        }
    } else {
        history = current; // No valid history, use current
    }

    // Blend
    float weight = validHistory ? pc.blendWeight : 1.0;
    vec3 result = mix(history, current, weight);

    // Optional sharpening (unsharp mask)
    if (pc.sharpness > 0.0) {
        vec3 blurred = vec3(0.0);
        float tw = 0.0;
        for (int y = -1; y <= 1; y++) {
            for (int x = -1; x <= 1; x++) {
                ivec2 p = clamp(pixel + ivec2(x, y), ivec2(0), size - ivec2(1));
                float w = (x == 0 && y == 0) ? 0.0 : 1.0;
                blurred += imageLoad(currentColor, p).rgb * w;
                tw += w;
            }
        }
        blurred /= max(tw, 1.0);
        result += (result - blurred) * pc.sharpness;
    }

    imageStore(outputColor, pixel, vec4(result, 1.0));
}
