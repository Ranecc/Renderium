#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r32f) readonly uniform image2D depthImage;
layout(set = 0, binding = 1, r32f) readonly uniform image2D shadowImage;
layout(set = 0, binding = 2, rgba16f) writeonly uniform image2D fogResultImage;

layout(push_constant) uniform PushConstants {
    float fogDensity;
    float heightFalloff;
    float heightBase;
    int raySteps;
    float anisotropyG;
    vec3 fogColor;
    float maxDistance;
    vec2 invScreenSize;
    mat4 invViewProj;
} pc;

// Henyey-Greenstein phase function
float henyeyGreenstein(float cosTheta, float g) {
    float g2 = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosTheta;
    return (1.0 - g2) / (4.0 * 3.14159265 * pow(denom, 1.5));
}

// Exponential height fog density
float fogDensityAtHeight(float worldY) {
    return pc.fogDensity * exp(-pc.heightFalloff * (worldY - pc.heightBase));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(depthImage);
    if (pixel.x >= size.x || pixel.y >= size.y) return;

    float depth = imageLoad(depthImage, pixel).r;

    // Reconstruct world position from depth
    vec2 uv = (vec2(pixel) + 0.5) * pc.invScreenSize;
    vec4 clipPos = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4 worldPos = pc.invViewProj * clipPos;
    worldPos.xyz /= worldPos.w;

    vec3 rayOrigin = vec3(0.0); // Camera position (TODO: pass via push constant)
    vec3 rayDir = normalize(worldPos.xyz - rayOrigin);
    float rayLength = min(length(worldPos.xyz - rayOrigin), pc.maxDistance);

    // Ray march
    float stepSize = rayLength / float(pc.raySteps);
    vec3 scattering = vec3(0.0);
    float transmittance = 1.0;

    for (int i = 0; i < pc.raySteps; i++) {
        float t = (float(i) + 0.5) * stepSize;
        vec3 samplePos = rayOrigin + rayDir * t;

        // Height-based density
        float density = fogDensityAtHeight(samplePos.y) * stepSize;

        // Shadow sampling (for light scattering)
        // TODO: transform samplePos to shadow space and sample shadowImage
        float shadow = 1.0; // No shadow by default

        // Scattering contribution
        vec3 lightDir = normalize(vec3(0.5, 1.0, 0.3)); // Sun direction (TODO: pass via push constant)
        float cosTheta = dot(rayDir, lightDir);
        float phase = henyeyGreenstein(cosTheta, pc.anisotropyG);

        vec3 scatteringContribution = pc.fogColor * density * phase * shadow;
        scattering += scatteringContribution * transmittance;
        transmittance *= exp(-density);
    }

    imageStore(fogResultImage, pixel, vec4(scattering, transmittance));
}
